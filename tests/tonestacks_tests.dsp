mesa_modulated_test = no.noise : ts.mesa(0.5, tri, 0.5) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
mesa_jump_test = no.noise : ts.mesa(0.5, 0.5, sq) with { P = int(ma.SR/10); sq = ba.period(2*P) < P; };
