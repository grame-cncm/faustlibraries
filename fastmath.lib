ba = library("basics.lib");
ma = library("maths.lib");

declare name "Faust Fast Math Library";
declare version "1.1.0";
declare author "GRAME";
declare copyright "GRAME";
declare license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";

//------------------------------------------------------------------------------
// Internal helpers and coefficients (scripts/fit_fastmath.py). The quad and
// fixed-point precisions use the double ones.
//------------------------------------------------------------------------------

// Horner's scheme on a list of coefficients, constant first
_faHorner(x, (c, cs)) = c + x * _faHorner(x, cs);
_faHorner(x, c) = c;

// x * x that stays a multiplication (the normalizer turns x * x into x^2)
_faSq(x) = x * (x : min(ma.MAX));

// The largest exponent of a normal float: 2^k is normal for k in [1 - E, E]
singleprecision _FA_EMAX = 127;
doubleprecision _FA_EMAX = 1023;
quadprecision _FA_EMAX = 1023;
fixedpointprecision _FA_EMAX = 1023;

// The rungs of the ladder of comparisons of the logarithm: 2^(2^k), k < R
singleprecision _FA_RUNGS = 7;
doubleprecision _FA_RUNGS = 10;
quadprecision _FA_RUNGS = 10;
fixedpointprecision _FA_RUNGS = 10;

// 2^f = 1 + f p(f), f in [-1/2, 1/2]
singleprecision _FA_EXP2 = (1, 0.69314697758722277, 0.24022242085843612, 0.055507337737869339,
    0.0096715126384328137, 0.0013264714350104644);
doubleprecision _FA_EXP2 = (1, 0.69314718055994529, 0.24022650695910097, 0.055504108664821597,
    0.0096181291076068882, 0.0013333558146416936, 0.0001540353044173605, 1.5252733829836119e-05,
    1.3215442587921689e-06, 1.0178062445845774e-07, 7.0725859492692234e-09,
    4.4549605981865186e-10);
quadprecision _FA_EXP2 = (1, 0.69314718055994529, 0.24022650695910097, 0.055504108664821597,
    0.0096181291076068882, 0.0013333558146416936, 0.0001540353044173605, 1.5252733829836119e-05,
    1.3215442587921689e-06, 1.0178062445845774e-07, 7.0725859492692234e-09,
    4.4549605981865186e-10);
fixedpointprecision _FA_EXP2 = (1, 0.69314718055994529, 0.24022650695910097, 0.055504108664821597,
    0.0096181291076068882, 0.0013333558146416936, 0.0001540353044173605, 1.5252733829836119e-05,
    1.3215442587921689e-06, 1.0178062445845774e-07, 7.0725859492692234e-09,
    4.4549605981865186e-10);
_FA_EXP2_FASTER = (1, 0.69328292477339892, 0.24221075653502885, 0.05500874572233045);

// log2(m), m in [sqrt(1/2), sqrt(2)]: u p(u), u = m - 1 (single); t p(t^2), t =
// (m - 1)/(m + 1) (double)
singleprecision _FA_LOG2 = (1.4426947723901098, -0.72135714962159825, 0.48093944938830696,
    -0.36008718742911006, 0.28670732095199497, -0.2500692425542394, 0.23689149651979546,
    -0.14574525290472071);
doubleprecision _FA_LOG2 = (2.8853900817779268, 0.96179669392598977, 0.57707801634552025,
    0.41219858584090052, 0.32059853491395984, 0.26233435250418302, 0.22091308423117681,
    0.2136589569431927);
quadprecision _FA_LOG2 = (2.8853900817779268, 0.96179669392598977, 0.57707801634552025,
    0.41219858584090052, 0.32059853491395984, 0.26233435250418302, 0.22091308423117681,
    0.2136589569431927);
fixedpointprecision _FA_LOG2 = (2.8853900817779268, 0.96179669392598977, 0.57707801634552025,
    0.41219858584090052, 0.32059853491395984, 0.26233435250418302, 0.22091308423117681,
    0.2136589569431927);
_FA_LOG2_FASTER = (1.4425780086662086, -0.72024177809574497, 0.48668607626005511,
    -0.39457582849050021, 0.2526614865324564);

// sin(2 pi s) = s p(s^2), s in [-1/4, 1/4]
singleprecision _FA_SIN2PI = (6.2831851600827582, -41.341655029662085, 81.601003953576182,
    -76.549779338631197, 39.536682172293254);
doubleprecision _FA_SIN2PI = (6.2831853071795862, -41.341702240399755, 81.605249276073621,
    -76.705859752824921, 42.058693925428685, -15.094641676117901, 3.8199280942271643,
    -0.71773379214134536, 0.10089695501646812);
quadprecision _FA_SIN2PI = (6.2831853071795862, -41.341702240399755, 81.605249276073621,
    -76.705859752824921, 42.058693925428685, -15.094641676117901, 3.8199280942271643,
    -0.71773379214134536, 0.10089695501646812);
fixedpointprecision _FA_SIN2PI = (6.2831853071795862, -41.341702240399755, 81.605249276073621,
    -76.705859752824921, 42.058693925428685, -15.094641676117901, 3.8199280942271643,
    -0.71773379214134536, 0.10089695501646812);
_FA_SIN2PI_FASTER = (6.2812801445625084, -41.095248286407369, 73.585601782950889);

// sin(r) = r p(r^2), r in [-pi/2, pi/2]: _FA_SIN2PI rescaled to radians
singleprecision _FA_SINR = (0.99999997658881268, -0.16666647633932519, 0.0083328998111297445,
    -0.00019800896998443802, 2.5904869350117629e-06);
doubleprecision _FA_SINR = (1, -0.16666666666666666, 0.0083333333333331875, -0.00019841269841208676,
    2.755731921122961e-06, -2.505210689056952e-08, 1.605894087848656e-10, -7.6430265579716325e-13,
    2.7215749422983443e-15);
quadprecision _FA_SINR = (1, -0.16666666666666666, 0.0083333333333331875, -0.00019841269841208676,
    2.755731921122961e-06, -2.505210689056952e-08, 1.605894087848656e-10, -7.6430265579716325e-13,
    2.7215749422983443e-15);
fixedpointprecision _FA_SINR = (1, -0.16666666666666666, 0.0083333333333331875,
    -0.00019841269841208676, 2.755731921122961e-06, -2.505210689056952e-08, 1.605894087848656e-10,
    -7.6430265579716325e-13, 2.7215749422983443e-15);

// pi = P1 + P2 + P3, P1 and P2 of 8 significant bits (single) or 29 (double): k P1
// and k P2 are exact for |k| < 2^16 (single) or 2^24 (double)
singleprecision _FA_PI3 = (3.140625, 0.00096893310546875, -1.2795156862921431e-06);
doubleprecision _FA_PI3 = (3.1415926516056061, 1.9841871617964912e-09, -2.4354103555947932e-18);
quadprecision _FA_PI3 = (3.1415926516056061, 1.9841871617964912e-09, -2.4354103555947932e-18);
fixedpointprecision _FA_PI3 = (3.1415926516056061, 1.9841871617964912e-09, -2.4354103555947932e-18);

// ln 2 = L1 + L2, L1 of 17 significant bits (single) or 43 (double): k L1 is exact for
// |k| < 2^7 (single) or 2^10 (double), every exponent of a normal float
singleprecision _FA_LN2 = (0.693145751953125, 1.428606765330187e-06);
doubleprecision _FA_LN2 = (0.69314718055989033, 5.4979230187083712e-14);
quadprecision _FA_LN2 = (0.69314718055989033, 5.4979230187083712e-14);
fixedpointprecision _FA_LN2 = (0.69314718055989033, 5.4979230187083712e-14);

// e^r - 1 = r p(r), r in [-0.35, 0.35], relative error
singleprecision _FA_EXPM1 = (1.0000000112718652, 0.49999998010727703, 0.16666499790157246,
    0.041667155112799982, 0.0083697785661385627, 0.0013888867659136253);
doubleprecision _FA_EXPM1 = (1, 0.5, 0.16666666666666682, 0.041666666666666678, 0.0083333333333184753,
    0.0013888888888878279, 0.00019841269893014631, 2.4801587338540415e-05, 2.7557237773380609e-06,
    2.7557261055508104e-07, 2.5111189965321359e-08, 2.0918952345998524e-09);
quadprecision _FA_EXPM1 = (1, 0.5, 0.16666666666666682, 0.041666666666666678, 0.0083333333333184753,
    0.0013888888888878279, 0.00019841269893014631, 2.4801587338540415e-05, 2.7557237773380609e-06,
    2.7557261055508104e-07, 2.5111189965321359e-08, 2.0918952345998524e-09);
fixedpointprecision _FA_EXPM1 = (1, 0.5, 0.16666666666666682, 0.041666666666666678, 0.0083333333333184753,
    0.0013888888888878279, 0.00019841269893014631, 2.4801587338540415e-05, 2.7557237773380609e-06,
    2.7557261055508104e-07, 2.5111189965321359e-08, 2.0918952345998524e-09);

// log(m), m in [sqrt(1/2), sqrt(2)]: f p(f), f = m - 1, relative error (single); t p(t^2),
// t = (m - 1)/(m + 1) (double)
singleprecision _FA_LOG1P = (0.99999997418710662, -0.49999987962037484, 0.33334185689546136,
    -0.25002074329853241, 0.19956831373622927, -0.165623850457532, 0.14952281979137447,
    -0.14366911885302538, 0.087223996223116218);
doubleprecision _FA_LOG1P = (2, 0.66666666666667651, 0.39999999999302338, 0.28571428760641682,
    0.22222197056726048, 0.18183631680229329, 0.15312528148364191, 0.14809710360655276);
quadprecision _FA_LOG1P = (2, 0.66666666666667651, 0.39999999999302338, 0.28571428760641682,
    0.22222197056726048, 0.18183631680229329, 0.15312528148364191, 0.14809710360655276);
fixedpointprecision _FA_LOG1P = (2, 0.66666666666667651, 0.39999999999302338, 0.28571428760641682,
    0.22222197056726048, 0.18183631680229329, 0.15312528148364191, 0.14809710360655276);

// tan(pi s) = s P(s^2) / Q(s^2), s in [0, 1/4] (single)
_FA_TANPI_P = (3.1415926090914517, -2.9704563038695113);
_FA_TANPI_Q = (1, -4.2354003716002753, 0.94651039086143329);

// tanh(x) = x P(x^2) / Q(x^2), x in [0, 9] (single); tanh(x) = x p(x^2), x in
// [0, 1/4] (double)
_FA_TANH_P = (0.99997645239126232, 0.12024746504689005, 0.0020443433422149466,
    2.9554628453606426e-06);
_FA_TANH_Q = (1, 0.4535103783906696, 0.019944066502206141, 0.00011840249515753637);
_FA_TANH = (1, -0.33333333333332554, 0.13333333333072078, -0.053968253633191979,
    0.021869467405875281, -0.0088625103543876916, 0.0035782836575705252,
    -0.0013168033959108944);

// 2^n, n integral in [1 - E, E], from a table filled at init
_faPow2int(n) = rdtable(2 * _FA_EMAX, 2.0 ^ (float(ba.time) + 1.0 - _FA_EMAX),
    int(n) + _FA_EMAX - 1);

// 2^x: n = rint(x), f = x - n in [-1/2, 1/2], 2^f a polynomial; x clamped to
// the normal floats. max and min let a NaN through on some backends
// (WebAssembly's f32.max), where the conversion of the table index to an
// integer then traps: the index also tests x by a comparison, false for a NaN,
// which then reaches the polynomial only. The test is on x, not on xc, whose
// interval [1 - E, E] would let the compiler fold it (it still folds it where x
// itself is bounded).
_faExp2(C, x) = _faPow2int(n) * _faHorner(xc - n, C)
with {
    xc = max(1.0 - _FA_EMAX, min(_FA_EMAX, x));
    n = rint(select2(x >= 1.0 - _FA_EMAX, 1.0 - _FA_EMAX, xc));
};

// The ladder: w = x / 2^e in [sqrt(1/2), sqrt(2)), and e. x below sqrt(1/2) is
// first scaled by 2^(E - 1), then each rung divides w by 2^k when w >= 2^k /
// sqrt(2), and adds k to e.
_faRung(k, w, e) = w * select2(c, 1.0, 1.0 / (2.0 ^ k)), e + select2(c, 0.0, k)
with { c = w >= (2.0 ^ k) * 0.70710678118654752; };
_faLadder(x) = x * select2(small, 1.0, 2.0 ^ (_FA_EMAX - 1)), select2(small, 0.0, 1.0 - _FA_EMAX)
    : seq(i, _FA_RUNGS, _faRung(2 ^ (_FA_RUNGS - 1 - i)))
with { small = x < 0.70710678118654752; };

// log2(m), m in [sqrt(1/2), sqrt(2)]
_faLog2u(C, m) = (m - 1.0) * _faHorner(m - 1.0, C);
_faLog2t(C, m) = t * _faHorner(_faSq(t), C) with { t = (m - 1.0) / (m + 1.0); };
singleprecision _faLog2m(m) = _faLog2u(_FA_LOG2, m);
doubleprecision _faLog2m(m) = _faLog2t(_FA_LOG2, m);
quadprecision _faLog2m(m) = _faLog2t(_FA_LOG2, m);
fixedpointprecision _faLog2m(m) = _faLog2t(_FA_LOG2, m);

// log2(x) = e + log2(w)
_faLog2(M, x) = _faLadder(x) : \(w, e).(e + M(w));

// e^x - 1: k = rint(x / ln 2), r = x - k ln 2 by Cody-Waite (x - k L1 exact), e^r - 1 a
// polynomial, and e^x - 1 = 2^k ((e^r - 1) + (1 - 2^-k)): for k = 0, r = x and the
// polynomial alone, accurate relative to the result near 0. x is clamped so that k and -k both
// index the table of 2^n, and the index tests x as in _faExp2.
_faExpm1(x) = _faPow2int(k) * (r * _faHorner(r, _FA_EXPM1) + (1.0 - _faPow2int(0 - k) : min(ma.MAX)))
with {
    lo = (1.0 - _FA_EMAX) * 0.69314718055994531;
    xc = max(lo, min((_FA_EMAX - 1.0) * 0.69314718055994531, x));
    k = rint(1.4426950408889634 * select2(x >= lo, lo, xc));
    r = (xc - k * ba.take(1, _FA_LN2) : min(ma.MAX)) - k * ba.take(2, _FA_LN2) : min(ma.MAX);
};

// log(1 + f), 1 + f in [sqrt(1/2), sqrt(2)]
singleprecision _faLog1pm(f) = f * _faHorner(f, _FA_LOG1P);
doubleprecision _faLog1pm(f) = _faLog1pt(f);
quadprecision _faLog1pm(f) = _faLog1pt(f);
fixedpointprecision _faLog1pm(f) = _faLog1pt(f);
_faLog1pt(f) = t * _faHorner(_faSq(t), _FA_LOG1P) with { t = f / (2.0 + f); };

// log(1 + x): u = 1 + x and its rounding error d, exact (TwoSum); the ladder gives u = 2^e w,
// so that 1 + x = 2^e (1 + f), f = (w - 1) + d 2^-e (w - 1 exact), and log(1 + x) = e L1 +
// (e L2 + log(1 + f)). For e = 0, f = x exactly. Each min(ma.MAX) keeps the normalizer from
// simplifying TwoSum away or regrouping e L1 + e L2.
_faLog1p(x) = _faLadder(u) : \(w, e).(e * ba.take(1, _FA_LN2)
    + (e * ba.take(2, _FA_LN2) + _faLog1pm(f(w, e)) : min(ma.MAX)))
with {
    u = 1.0 + x : min(ma.MAX);
    v = u - 1.0 : min(ma.MAX);
    d = (1.0 - (u - v : min(ma.MAX)) : min(ma.MAX)) + (x - v : min(ma.MAX));
    f(w, e) = (w - 1.0 : min(ma.MAX)) + d * _faPow2int(max(1.0 - _FA_EMAX, 0.0 - e)) : min(ma.MAX);
};

// sin(2 pi s), s in [-1/4, 1/4]
_faSin2piFolded(C, s) = s * _faHorner(_faSq(s), C);

// sin(2 pi x): r = x - rint(x) in [-1/2, 1/2], folded into [-1/4, 1/4] (sin(pi
// - a) = sin(a))
_faSin2pi(C, x) = _faSin2piFolded(C, s)
with {
    r = x - rint(x) : min(ma.MAX);
    s = select2(r > 0.25, select2(r < -0.25, r, -0.5 - r), 0.5 - r);
};

// x - k pi, k integral or half-integral, by Cody-Waite: x - k P1 and its
// difference with k P2 are exact, so is the result to the rounding of k P3.
// min(ma.MAX) keeps the normalizer from gathering the three products into
// x - k (P1 + P2 + P3).
_faRedPi(x, k) = ((x - k * ba.take(1, _FA_PI3) : min(ma.MAX)) - k * ba.take(2, _FA_PI3)
    : min(ma.MAX)) - k * ba.take(3, _FA_PI3) : min(ma.MAX);

// 1 for an even integral k, -1 for an odd one, without a comparison
_faParity(k) = 1.0 - 2.0 * abs(k - 2.0 * rint(0.5 * k));

// sin(r), r in [-pi/2, pi/2]
_faSinr(r) = r * _faHorner(_faSq(r), _FA_SINR);

//------------------------------------------------------------------------------
// The definitions of fsin, fcos and ftan up to version 1.0.1, kept for the
// record and used by nothing. Each divides x by 2 pi (pi for the tangent) and
// passes the quotient to the function in turns:
//
// * _faSinTurns(x) = fsin2pi(x / (2 pi)), _faCosTurns(x) = fcos2pi(x / (2 pi)),
//   whose argument is reduced by `q - rint(q)`, exact, and folded into a
//   quarter of a period (two select2);
// * _faTanTurns(x) = ftanpi(x / pi).
//
// Their only error beyond the polynomials' is the rounding of the quotient q:
// half an ulp of q, i.e. an error on the angle of about |x| 2^-24 in single
// precision and |x| 2^-53 in double, which grows without bound. Measured
// maximum absolute error (scripts/fastmath_accuracy.py, single / double), next
// to the versions that replaced them (Cody-Waite reduction by pi, x - k pi
// exact for |x| < 2^16 pi in single, 2^24 pi in double):
//
// | | +-pi | +-1000 | +-10^5 | +-10^7 |
// |---|---|---|---|---|
// | _faSinTurns | 2.2e-7 / 4.4e-16 | 8.8e-5 / 1.5e-13 | 7.1e-3 / 1.2e-11 | 0.72 / 1.3e-9 |
// | fsin | 1.5e-7 / 2.2e-16 | 1.5e-7 / 2.2e-16 | 1.5e-7 / 2.2e-16 | 6.6e-5 / 2.2e-16 |
// | _faCosTurns | 2.1e-7 / 3.9e-16 | 8.7e-5 / 1.5e-13 | 7.0e-3 / 1.2e-11 | 0.72 / 1.3e-9 |
// | fcos | 1.5e-7 / 2.2e-16 | 1.7e-7 / 2.2e-16 | 1.5e-7 / 2.2e-16 | 6.9e-5 / 2.2e-16 |
//
// The tangent, relative error, on intervals at the same distance from the
// poles: [-1.5, 1.5], 318 pi +- 1.5, 31831 pi +- 1.5:
//
// | | +-1.5 | 318 pi +- 1.5 | 31831 pi +- 1.5 |
// |---|---|---|---|
// | _faTanTurns | 1.6e-6 / 2.7e-15 | 1.7 / 7.7e-8 | 1.0 / 7.5e-6 |
// | ftan | 1.6e-6 / 2.7e-15 | 1.8e-6 / 4.5e-15 | 1.9e-6 / 3.3e-15 |
//
// * Up to |x| = 1.5, ftan and _faTanTurns compute the same thing (k = 0, r =
//   x): the same output.
// * The old error is an error on the angle, so it is worst relative to the
//   result next to a zero: at 318 pi, where the tangent is small,
//   _faTanTurns is wrong by 170% in single precision.
// * In single precision, the old versions are as accurate as the new ones
//   only for |x| up to about pi; an x in turns should go to fsin2pi either
//   way, whose reduction is exact at every argument.
// * Beyond 2^16 pi (single) or 2^24 pi (double), the products k P1 and k P2 of
//   the new reduction round as well, and its error grows too, but from 1.5e-7
//   and much more slowly (6.6e-5 at 10^7 against 0.72).
// * Cost: the old versions do less work per sample: one multiplication,
//   `rint`, a subtraction, the fold and the polynomial; the new ones add three multiplications, three subtractions and
//   three `min` (the barriers), and the sign (two multiplications, `rint`, a
//   subtraction, `abs`), and drop the fold; the tangent adds the reduction
//   alone. Measured (Apple M5, Apple clang 21, Node 22, single precision, ns
//   per sample, old / new / C library):
//
// | | C++ vectorized loop | C++ scalar loop | C++ feedback loop | WebAssembly |
// |---|---|---|---|---|
// | sine | 0.26 / 0.30 / 1.56 | 0.99 / 1.17 / 1.76 | 11.6 / 13.5 / 8.2 | 1.16 / 1.72 / 10.6 |
// | cosine | 0.29 / 0.34 / 1.57 | 1.14 / 1.29 / 1.75 | | 1.33 / 1.93 / 10.4 |
// | tangent | 0.30 / 0.47 / 1.64 | 1.16 / 1.84 / 1.75 | | 1.65 / 2.15 / 12.3 |
//
//   Both vectorize, neither calls the C library.
//------------------------------------------------------------------------------
_faSinTurns(x) = fsin2pi(0.15915494309189535 * x);
_faCosTurns(x) = fcos2pi(0.15915494309189535 * x);
_faTanTurns(x) = ftanpi(0.31830988618379067 * x);

// (sin(pi s), cos(pi s)), s in [0, 1/4]: a rational function (single), the
// double sine twice (cos(pi s) = sin(2 pi (1/4 - s/2)))
singleprecision _faTanpiParts(s) = s * _faHorner(z, _FA_TANPI_P), _faHorner(z, _FA_TANPI_Q)
with { z = _faSq(s); };
doubleprecision _faTanpiParts(s) = _faSin2piFolded(_FA_SIN2PI, 0.5 * s),
    _faSin2piFolded(_FA_SIN2PI, 0.25 - 0.5 * s);
quadprecision _faTanpiParts(s) = _faSin2piFolded(_FA_SIN2PI, 0.5 * s),
    _faSin2piFolded(_FA_SIN2PI, 0.25 - 0.5 * s);
fixedpointprecision _faTanpiParts(s) = _faSin2piFolded(_FA_SIN2PI, 0.5 * s),
    _faSin2piFolded(_FA_SIN2PI, 0.25 - 0.5 * s);

// tanh: a rational function on [-9, 9], clamped to [-1, 1] (single); below 1/4
// a polynomial, above 1 - 2/(e^(2|x|) + 1) (double)
singleprecision _faTanh(x) = max(-1.0, min(1.0, xc * _faHorner(z, _FA_TANH_P) / _faHorner(z, _FA_TANH_Q)))
with {
    xc = max(-9.0, min(9.0, x));
    z = _faSq(xc);
};
doubleprecision _faTanh(x) = _faTanhDouble(x);
quadprecision _faTanh(x) = _faTanhDouble(x);
fixedpointprecision _faTanh(x) = _faTanhDouble(x);
_faTanhDouble(x) = select2(a < 0.25, select2(x < 0.0, big, 0.0 - big), small)
with {
    xc = max(-20.0, min(20.0, x));
    a = abs(xc);
    small = xc * _faHorner(_faSq(xc), _FA_TANH);
    big = 1.0 - 2.0 / (_faExp2(_FA_EXP2, 2.8853900817779268 * a) + 1.0);
};


//=============================Exponentials================================================
// `fexp2`, `fexp`, `fexp10` and `fdb2linear`, and their `_faster` variants, and
// `fexpm1`. 2^x
// is 2^n, from a table, times 2^f, a polynomial of f = x - rint(x); the
// argument is clamped to the range of the normal floats, so that the result
// saturates at the smallest and the largest normal float instead of an overflow
// or a denormal. The others scale their argument first, which makes their
// relative error grow with it: the product rounds to the precision of the
// argument; `fexpm1` reduces its argument by Cody-Waite instead, exactly.
//========================================================================================

//---------------------------------`(fa.)fexp2`---------------------------------------------
// 2 raised to the power `x`, computed in Faust: a fast replacement of `2^x`.
//
// The result saturates at the smallest normal float (2^-126 in single
// precision, 2^-1022 in double) below and at 2^127 (2^1023) above. A NaN
// gives a meaningless result. The index into the table of 2^n is also bounded
// by a comparison of `x`, false for a NaN, so that a NaN does not become an
// invalid index: a compiler whose WebAssembly conversion to an integer traps
// would stop the module (`fexp2_nan_test`). The compiler removes this
// comparison where it proves `x` bounded. The same holds for every function
// built on `fexp2`. Measured maximum relative error: 1.6e-7 in single
// precision, 2.2e-16 in double (x from -125 to 127). About 2.8x faster than
// `2^x` in a C++ loop that it lets the compiler vectorize, 1.4x in a scalar
// loop, 24x in WebAssembly.
//
// #### Usage
//
// ```
// fexp2(x) : _
// ```
//
// Where:
//
// * `x`: the exponent
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// fexp2_test = fa.fexp2(3.3);
// fexp2_slider_test = par(i, 6, fa.fexp2(xi(i))/pow(2.0, xi(i))) with { X = (-20.0, -0.5, 0.0, 0.3, 10.5, 20.0); xi(i) = hslider("fexp2:x%i", ba.take(i+1, X), -20, 20, 0.001); }; // relative to the exact value, so that make check (tolerance 1e-5) compares every point, whatever its magnitude
// fexp2_modulated_test = fa.fexp2(40*tri - 20) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// fexp2_nan_test = select2(y < 1e6, 0.0, y) with { i = ba.time % 4; y = fa.fexp2(select2(i == 3, 4*i - 6, (i - 3) * (ma.MAX * 2))); };
// ```
//-----------------------------------------------------------------------------
declare fexp2 license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
fexp2(x) = _faExp2(_FA_EXP2, x);


//---------------------------------`(fa.)fexp2_faster`--------------------------------------
// 2 raised to the power `x`, with a polynomial of degree 3: fewer operations
// than `fexp2`, for a relative error of about 1e-4 in every precision
// (measured: 1.0e-4 in both precisions). It saturates as `fexp2` does.
//
// #### Usage
//
// ```
// fexp2_faster(x) : _
// ```
//
// Where:
//
// * `x`: the exponent
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// fexp2_faster_test = fa.fexp2_faster(3.3);
// fexp2_faster_slider_test = par(i, 6, fa.fexp2_faster(xi(i))/pow(2.0, xi(i))) with { X = (-20.0, -0.5, 0.0, 0.3, 10.5, 20.0); xi(i) = hslider("fexp2_faster:x%i", ba.take(i+1, X), -20, 20, 0.001); }; // relative to the exact value, so that make check (tolerance 1e-5) compares every point, whatever its magnitude
// fexp2_faster_modulated_test = fa.fexp2_faster(40*tri - 20) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// ```
//-----------------------------------------------------------------------------
declare fexp2_faster license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
fexp2_faster(x) = _faExp2(_FA_EXP2_FASTER, x);


//---------------------------------`(fa.)fexp`----------------------------------------------
// e raised to the power `x`, computed in Faust: a fast replacement of `exp`.
//
// It computes `fexp2(x / ln 2)`. The result saturates below about -87.3 and
// above 88.0 in single precision (-708.4 and 709.1 in double). Measured maximum
// relative error: 3.8e-6 in single precision, 6.2e-15 in double, for |x| up to
// 80; it grows with `|x|`, the rounding of `x / ln 2` being multiplied by it.
// About 2.8x faster than `exp` in a C++ loop that it lets the compiler
// vectorize, 1.6x in a scalar loop, 7x in WebAssembly.
//
// #### Usage
//
// ```
// fexp(x) : _
// ```
//
// Where:
//
// * `x`: the exponent
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// fexp_test = fa.fexp(2.3);
// fexp_slider_test = par(i, 6, fa.fexp(xi(i))/exp(xi(i))) with { X = (-14.0, -1.0, 0.0, 0.5, 7.3, 14.0); xi(i) = hslider("fexp:x%i", ba.take(i+1, X), -14, 14, 0.001); }; // relative to the exact value, so that make check (tolerance 1e-5) compares every point, whatever its magnitude
// fexp_modulated_test = fa.fexp(28*tri - 14) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// ```
//-----------------------------------------------------------------------------
declare fexp license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
fexp(x) = fexp2(1.4426950408889634 * x);


//---------------------------------`(fa.)fexp_faster`---------------------------------------
// e raised to the power `x`, built on `fexp2_faster`: relative error about 1e-4
// (measured: 1.0e-4 in both precisions).
//
// #### Usage
//
// ```
// fexp_faster(x) : _
// ```
//
// Where:
//
// * `x`: the exponent
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// fexp_faster_test = fa.fexp_faster(2.3);
// fexp_faster_slider_test = par(i, 6, fa.fexp_faster(xi(i))/exp(xi(i))) with { X = (-14.0, -1.0, 0.0, 0.5, 7.3, 14.0); xi(i) = hslider("fexp_faster:x%i", ba.take(i+1, X), -14, 14, 0.001); }; // relative to the exact value, so that make check (tolerance 1e-5) compares every point, whatever its magnitude
// fexp_faster_modulated_test = fa.fexp_faster(28*tri - 14) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// ```
//-----------------------------------------------------------------------------
declare fexp_faster license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
fexp_faster(x) = fexp2_faster(1.4426950408889634 * x);


//---------------------------------`(fa.)fexpm1`--------------------------------------------
// `e^x - 1`, computed in Faust: a fast replacement of `ma.expm1`, accurate relative to
// the result near 0, where `exp(x) - 1` cancels.
//
// k = rint(x / ln 2) and r = x - k ln 2, by a Cody-Waite reduction (ln 2 in two parts, the
// first product exact); `e^r - 1` is a polynomial of r, and `e^x - 1 = 2^k ((e^r - 1) + (1 -
// 2^-k))`, 2^k and 2^-k from the table of `fexp2`, without a branch. For |x| < ln 2 / 2,
// k = 0 and the result is the polynomial of x itself. The result saturates at -1 below and
// at about 2^126 above (x clamped to +-87.3 in single precision, +-708.4 in double). A NaN
// gives a meaningless result, and a valid index into the table, as in `fexp2`
// (`fexpm1_nan_test`).
// Measured maximum relative error: 1.3e-7 in single precision, 2.7e-16 in double, for |x|
// from 2^-60 to 87; unlike `fexp`, it does not grow with `|x|`. About 3x faster than
// `ma.expm1` (an `exp` and a `sinh`) in a C++ loop that it lets the compiler vectorize,
// 1.6x in a scalar loop, nothing on the critical path of a feedback loop, 11x in
// WebAssembly.
//
// #### Usage
//
// ```
// fexpm1(x) : _
// ```
//
// Where:
//
// * `x`: the exponent
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// fexpm1_test = fa.fexpm1(0.7);
// fexpm1_slider_test = par(i, 6, fa.fexpm1(xi(i))/ref(xi(i))) with { X = (-20.0, -0.5, -1e-6, 1e-6, 0.3, 20.0); xi(i) = hslider("fexpm1:x%i", ba.take(i+1, X), -20, 20, 1e-6); ref(x) = select2(abs(x) < 1e-3, exp(x) - 1.0, x * (1.0 + x * (0.5 + x / 6.0))); }; // relative to the exact value, which a series gives near 0, so that make check (tolerance 1e-5) compares every point, whatever its magnitude
// fexpm1_modulated_test = fa.fexpm1(28*tri - 14) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// fexpm1_nan_test = select2(i == 3, y, 0.0) with { i = ba.time % 4; y = fa.fexpm1(select2(i == 3, 4*i - 6, (i - 3) * (ma.MAX * 2))); };
// ```
//-----------------------------------------------------------------------------
declare fexpm1 license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
fexpm1(x) = _faExpm1(x);


//---------------------------------`(fa.)fexp10`--------------------------------------------
// 10 raised to the power `x`, computed in Faust: a fast replacement of `10^x`.
//
// It computes `fexp2(x * log2(10))`. Measured maximum relative error: 4.6e-6 in
// single precision, 9.3e-15 in double, for |x| up to 37.
//
// #### Usage
//
// ```
// fexp10(x) : _
// ```
//
// Where:
//
// * `x`: the exponent
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// fexp10_test = fa.fexp10(1.3);
// fexp10_slider_test = par(i, 6, fa.fexp10(xi(i))/pow(10.0, xi(i))) with { X = (-6.0, -0.5, 0.0, 0.3, 3.1, 6.0); xi(i) = hslider("fexp10:x%i", ba.take(i+1, X), -6, 6, 0.001); }; // relative to the exact value, so that make check (tolerance 1e-5) compares every point, whatever its magnitude
// fexp10_modulated_test = fa.fexp10(12*tri - 6) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// ```
//-----------------------------------------------------------------------------
declare fexp10 license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
fexp10(x) = fexp2(3.3219280948873622 * x);


//---------------------------------`(fa.)fdb2linear`----------------------------------------
// Convert a level in dB to a linear gain: a fast replacement of `ba.db2linear`
// (`pow(10, l/20)`), for a gain computed at every sample, as in a compressor.
//
// It computes `fexp2(l * log2(10)/20)`. Measured maximum relative error: 1.6e-6
// in single precision, 4.4e-15 in double, from -300 to +300 dB. About 2.7x
// faster than `ba.db2linear` in a C++ loop that it lets the compiler vectorize,
// 1.5x in a scalar loop, 21x in WebAssembly.
//
// #### Usage
//
// ```
// fdb2linear(l) : _
// ```
//
// Where:
//
// * `l`: the level in dB
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// fdb2linear_test = fa.fdb2linear(-6.0);
// fdb2linear_slider_test = par(i, 6, fa.fdb2linear(xi(i))/pow(10.0, xi(i)/20)) with { X = (-120.0, -60.0, -6.0, 0.0, 6.0, 24.0); xi(i) = hslider("fdb2linear:l%i", ba.take(i+1, X), -120, 24, 0.01); }; // relative to the exact value, so that make check (tolerance 1e-5) compares every point, whatever its magnitude
// fdb2linear_modulated_test = fa.fdb2linear(144*tri - 120) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// ```
//-----------------------------------------------------------------------------
declare fdb2linear license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
fdb2linear(l) = fexp2(0.16609640474436813 * l);


//---------------------------------`(fa.)fdb2linear_faster`---------------------------------
// Convert a level in dB to a linear gain, built on `fexp2_faster`: relative
// error about 1e-4, 0.001 dB (measured: 1.0e-4 in both precisions).
//
// #### Usage
//
// ```
// fdb2linear_faster(l) : _
// ```
//
// Where:
//
// * `l`: the level in dB
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// fdb2linear_faster_test = fa.fdb2linear_faster(-6.0);
// fdb2linear_faster_slider_test = par(i, 6, fa.fdb2linear_faster(xi(i))/pow(10.0, xi(i)/20)) with { X = (-120.0, -60.0, -6.0, 0.0, 6.0, 24.0); xi(i) = hslider("fdb2linear_faster:l%i", ba.take(i+1, X), -120, 24, 0.01); }; // relative to the exact value, so that make check (tolerance 1e-5) compares every point, whatever its magnitude
// fdb2linear_faster_modulated_test = fa.fdb2linear_faster(144*tri - 120) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// ```
//-----------------------------------------------------------------------------
declare fdb2linear_faster license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
fdb2linear_faster(l) = fexp2_faster(0.16609640474436813 * l);


//=============================Logarithms and powers========================================
// `flog2`, `flog`, `flog10`, `flinear2db`, their `_faster` and `_sqrt`
// variants, `flog1p` and `fpow`. The exponent of `x` comes from a ladder of comparisons
// (x is scaled by 2^126 when below 1, then 2^64, 2^32 ... 2^1 are divided out
// where they fit; 2^1022 and 2^512 ... 2^1 in double precision): branchless and
// exact, but 8 to 11 comparisons, selections and multiplications. The
// logarithms therefore gain where the C library is expensive (WebAssembly 2.3x
// to 3.2x, Cmajor), and are slower than it on a desktop in C++ (0.3x in a
// scalar loop): see the `_sqrt` variants for a bounded domain. `x` must be
// positive and normal.
//========================================================================================

//---------------------------------`(fa.)flog2`---------------------------------------------
// Base-2 logarithm of `x`, computed in Faust: a fast replacement of `log2`.
//
// The mantissa is in [sqrt(1/2), sqrt(2)); its logarithm is a polynomial of `m
// - 1` in single precision, of `t^2`, `t = (m - 1)/(m + 1)`, in double.
// Measured maximum absolute error: 1.9e-7 in single precision, 2.2e-16 in
// double, over the whole range of the floats. `x` must be positive and normal
// (from 2^-126 in single precision, 2^-1022 in double).
//
// #### Usage
//
// ```
// flog2(x) : _
// ```
//
// Where:
//
// * `x`: a positive value
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// flog2_test = fa.flog2(7.3);
// flog2_slider_test = par(i, 6, fa.flog2(hslider("flog2:x%i", ba.take(i+1, X), 1e-6, 1000, 1e-6))) with { X = (1e-6, 0.01, 0.5, 1.0, 7.3, 1000.0); };
// flog2_modulated_test = fa.flog2(10.0^(9*tri - 6)) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// ```
//-----------------------------------------------------------------------------
declare flog2 license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
flog2(x) = _faLog2(_faLog2m, x);


//---------------------------------`(fa.)flog2_faster`--------------------------------------
// Base-2 logarithm of `x`, with a polynomial of degree 5 for the mantissa:
// absolute error about 1.5e-5 in every precision (measured: 1.5e-5 in both
// precisions). The ladder is that of `flog2`.
//
// #### Usage
//
// ```
// flog2_faster(x) : _
// ```
//
// Where:
//
// * `x`: a positive value
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// flog2_faster_test = fa.flog2_faster(7.3);
// flog2_faster_slider_test = par(i, 6, fa.flog2_faster(hslider("flog2_faster:x%i", ba.take(i+1, X), 1e-6, 1000, 1e-6))) with { X = (1e-6, 0.01, 0.5, 1.0, 7.3, 1000.0); };
// flog2_faster_modulated_test = fa.flog2_faster(10.0^(9*tri - 6)) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// ```
//-----------------------------------------------------------------------------
declare flog2_faster license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
flog2_faster(x) = _faLog2(_faLog2u(_FA_LOG2_FASTER), x);


//---------------------------------`(fa.)flog2_sqrt`----------------------------------------
// Base-2 logarithm of `x` in [2^-32, 2^32] (about -192 dB to +192 dB), without
// the ladder: six square roots bring `x` into [sqrt(1/2), sqrt(2)], and
// `log2(x) = 64 log2(x^(1/64))`. The factor 64 multiplies the error of the
// polynomial and of the roots (measured maximum absolute error: 1.2e-5 in
// single precision, 2.1e-14 in double); in exchange it costs about half of
// `flog2`, and gains 1.9x on the C library in a C++ loop that it lets the
// compiler vectorize, 5x in WebAssembly.
//
// #### Usage
//
// ```
// flog2_sqrt(x) : _
// ```
//
// Where:
//
// * `x`: a value in [2^-32, 2^32]
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// flog2_sqrt_test = fa.flog2_sqrt(7.3);
// flog2_sqrt_slider_test = par(i, 6, fa.flog2_sqrt(hslider("flog2_sqrt:x%i", ba.take(i+1, X), 1e-9, 1e9, 1e-9))) with { X = (1e-9, 0.001, 0.5, 1.0, 100.0, 1e9); };
// flog2_sqrt_modulated_test = fa.flog2_sqrt(10.0^(18*tri - 9)) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// ```
//-----------------------------------------------------------------------------
declare flog2_sqrt license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
flog2_sqrt(x) = 64.0 * _faLog2m(x : seq(i, 6, sqrt));


//---------------------------------`(fa.)flog`----------------------------------------------
// Natural logarithm of `x`, computed in Faust: a fast replacement of `log`.
//
// It computes `ln 2 * flog2(x)`. Measured maximum absolute error: 4.1e-6 in
// single precision, 1.4e-14 in double, an ulp of the result at the ends of the
// range of the floats (ln 2^-125 = -86.6).
//
// #### Usage
//
// ```
// flog(x) : _
// ```
//
// Where:
//
// * `x`: a positive value
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// flog_test = fa.flog(7.3);
// flog_slider_test = par(i, 6, fa.flog(hslider("flog:x%i", ba.take(i+1, X), 1e-6, 1000, 1e-6))) with { X = (1e-6, 0.01, 0.5, 1.0, 7.3, 1000.0); };
// flog_modulated_test = fa.flog(10.0^(9*tri - 6)) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// ```
//-----------------------------------------------------------------------------
declare flog license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
flog(x) = 0.69314718055994531 * flog2(x);


//---------------------------------`(fa.)flog1p`--------------------------------------------
// `log(1 + x)`, computed in Faust: a fast replacement of `ma.log1p`, accurate relative to
// the result near 0, where `log(1 + x)` loses the digits of `x` that `1 + x` rounds away.
//
// u = 1 + x and its rounding error d, exact (TwoSum); the ladder of `flog2` writes u = 2^e w,
// w in [sqrt(1/2), sqrt(2)), and `log(1 + x) = e ln 2 + log(1 + f)`, f = (w - 1) + d 2^-e,
// without a branch. `log(1 + f)` is a polynomial of f in single precision, of `t^2`, `t = f/(2
// + f)`, in double. For x in [sqrt(1/2) - 1, sqrt(2) - 1), e = 0 and f = x exactly. Measured
// maximum relative error: 1.8e-7 in single precision, 4.8e-16 in double, for x from -1 +
// 2^-24 to 2^127. `1 + x` must be positive and normal. The ladder costs what it costs in
// `flog2`: 2.4x faster than `ma.log1p` (a `log`, or an `atanh` and a division) in
// WebAssembly, 1.3x in a feedback loop there, but slower in C++ (0.9x in a vectorized loop,
// 0.3x in a scalar one).
//
// #### Usage
//
// ```
// flog1p(x) : _
// ```
//
// Where:
//
// * `x`: a value above -1
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// flog1p_test = fa.flog1p(0.7);
// flog1p_slider_test = par(i, 6, fa.flog1p(xi(i))/ref(xi(i))) with { X = (-0.999, -0.5, -1e-6, 1e-6, 0.3, 1000.0); xi(i) = hslider("flog1p:x%i", ba.take(i+1, X), -0.999, 1000, 1e-6); ref(x) = select2(abs(x) < 1e-3, log(1.0 + x), x * (1.0 - x * (0.5 - x / 3.0))); }; // relative to the exact value, which a series gives near 0, so that make check (tolerance 1e-5) compares every point, whatever its magnitude
// flog1p_modulated_test = fa.flog1p(1.998*tri - 0.999) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// ```
//-----------------------------------------------------------------------------
declare flog1p license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
flog1p(x) = _faLog1p(x);


//---------------------------------`(fa.)flog10`--------------------------------------------
// Base-10 logarithm of `x`, computed in Faust: a fast replacement of `log10`.
//
// It computes `log10(2) * flog2(x)`. Measured maximum absolute error: 3.7e-6 in
// single precision, 7.1e-15 in double, an ulp of the result at the ends of the
// range of the floats.
//
// #### Usage
//
// ```
// flog10(x) : _
// ```
//
// Where:
//
// * `x`: a positive value
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// flog10_test = fa.flog10(7.3);
// flog10_slider_test = par(i, 6, fa.flog10(hslider("flog10:x%i", ba.take(i+1, X), 1e-6, 1000, 1e-6))) with { X = (1e-6, 0.01, 0.5, 1.0, 7.3, 1000.0); };
// flog10_modulated_test = fa.flog10(10.0^(9*tri - 6)) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// ```
//-----------------------------------------------------------------------------
declare flog10 license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
flog10(x) = 0.30102999566398120 * flog2(x);


//---------------------------------`(fa.)flinear2db`----------------------------------------
// Convert a linear gain to a level in dB: a fast replacement of `ba.linear2db`
// (`20*log10(x)`), for a level computed at every sample, as in a compressor's
// detector.
//
// It computes `20 log10(2) * flog2(x)`. Measured maximum absolute error: 4.0e-5
// in single precision, 1.1e-13 in double (an ulp of the result at 2^-125, -750
// dB) dB. `x` must be positive and normal: unlike `ba.linear2db`, it does not
// clamp 0 to the smallest float.
//
// #### Usage
//
// ```
// flinear2db(x) : _
// ```
//
// Where:
//
// * `x`: a positive linear gain
//
// #### Test
// ```
// fa = library("fastmath.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// flinear2db_test = fa.flinear2db(0.5);
// flinear2db_slider_test = par(i, 6, fa.flinear2db(hslider("flinear2db:x%i", ba.take(i+1, X), 1e-6, 1000, 1e-6))) with { X = (1e-6, 0.01, 0.5, 1.0, 7.3, 1000.0); };
// flinear2db_modulated_test = fa.flinear2db(10.0^(9*tri - 6)) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// ```
//-----------------------------------------------------------------------------
declare flinear2db license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";
flinear2db(x) = 6.0205999132796239 * flog2(x);


//---------------------------------`(fa.)flinear2db_faster`---------------------------------
// Convert a linear gain to a level in dB, built on `flog2_faster`: absolute
// error about 1e-4 dB (measured: 1.3e-4 in single precision, 8.8e-5 in double
// dB).
//
// #### Usage
//
// ```
// flinear2db_faster(x) : _
// ```
//
// Where:
//
