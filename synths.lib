ma = library("maths.lib");
ba = library("basics.lib");
en = library("envelopes.lib");
fi = library("filters.lib");
os = library("oscillators.lib");
no = library("noises.lib");
it = library("interpolators.lib");

declare name "Faust Synthesizer Library";
declare version "1.2.0";

//===============================Synthesizers===================================
//==============================================================================

//-----------------------------------`(sy.)popFilterDrum`--------------------------------------
// A simple percussion instrument based on a "popped" resonant bandpass filter.
// `popFilterDrum` is a standard Faust function.
//
// #### Usage
//
// ```
// popFilterDrum(freq,q,gate) : _
// ```
//
// Where:
//
// * `freq`: the resonance frequency of the instrument in Hz
// * `q`: the q of the res filter (typically, 5 is a good value)
// * `gate`: the trigger signal (0 or 1)
//
// #### Test
// ```
// sy = library("synths.lib");
// popFilterDrum_test = sy.popFilterDrum(
//     hslider("popFilterDrum:freq", 200, 50, 1000, 1),
//     hslider("popFilterDrum:q", 5, 1, 20, 0.1),
//     button("popFilterDrum:gate")
// );
// ```
//----------------------------------------------------------------------------------------
declare popFilterDrum author "Romain Michon";

popFilterDrum(freq,q,gate) = en.ar(0.001,0.001,gate)*no.noise : fi.resonbp(freq,q,1);


//---------------------------------------`(sy.)dubDub`-----------------------------------------
// A simple synth based on a sawtooth wave filtered by a resonant lowpass.
// `dubDub` is a standard Faust function.
//
// #### Usage
//
// ```
// dubDub(freq,ctFreq,q,gate) : _
// ```
//
// Where:
//
// * `freq`: frequency of the sawtooth in Hz
// * `ctFreq`: cutoff frequency of the filter
// * `q`: Q of the filter
// * `gate`: the trigger signal (0 or 1)
//
// #### Test
// ```
// sy = library("synths.lib");
// dubDub_test = sy.dubDub(
//     hslider("dubDub:freq", 220, 50, 1000, 1),
//     hslider("dubDub:cutoff", 800, 100, 6000, 1),
//     hslider("dubDub:q", 2, 0.2, 10, 0.1),
//     button("dubDub:gate")
// );
// ```
//----------------------------------------------------------------------------------------
declare dubDub author "Romain Michon";

dubDub(freq,ctFreq,q,gate) = os.sawtooth(freq)*gainEnvelope : fi.resonlp(ctFreq,q,1)
with {
    maxGain = 0.5;
    gainEnvelope = en.smoothEnvelope(0.01,gate)*maxGain;
};


//-----------------------------------`(sy.)sawTrombone`----------------------------------------
// A simple trombone based on a lowpassed sawtooth wave.
// `sawTrombone` is a standard Faust function.
//
// #### Usage
//
// ```
// sawTrombone(freq,gain,gate) : _
// ```
//
// Where:
//
// * `freq`: the frequency in Hz
// * `gain`: the gain (0-1)
// * `gate`: the gate (0 or 1)
//
// #### Test
// ```
// sy = library("synths.lib");
// sawTrombone_test = sy.sawTrombone(
//     hslider("sawTrombone:freq", 196, 50, 600, 1),
//     hslider("sawTrombone:gain", 0.6, 0, 1, 0.01),
//     button("sawTrombone:gate")
// );
// ```
//----------------------------------------------------------------------------------------
declare sawTrombone author "Romain Michon";

sawTrombone(freq,gain,gate) = os.sawtooth(freq)*gainEnvelope : fi.lowpass(3,cutoff)
with {
    // controls both the gain of the instrument and the lowpass frequency
    gainEnvelope = en.smoothEnvelope(0.01,gate)*gain;
    cutoff = gainEnvelope*5000+50;
};


//-----------------------------------`(sy.)combString`-----------------------------------------
// Simplest string physical model ever based on a comb filter.
// `combString` is a standard Faust function.
//
// #### Usage
//
// ```
// combString(freq,res,gate) : _
// ```
//
// Where:
//
// * `freq`: the frequency of the string in Hz
// * `res`: string T60 (resonance time) in second
// * `gate`: trigger signal (0 or 1)
//
// #### Test
// ```
// sy = library("synths.lib");
// combString_test = sy.combString(
//     hslider("combString:freq", 220, 55, 880, 1),
//     hslider("combString:res", 4, 0.1, 10, 0.01),
//     button("combString:gate")
// );
// ```
//----------------------------------------------------------------------------------------
declare combString author "Romain Michon";

combString(freq,res,gate) = excitation : fi.fb_fcomb(maxDel,N,b0,aN)
with {
    maxDel = 1024;
    N = ma.SR/freq;
    b0 = 1;
    aN = ba.tau2pole(res*0.001)*-1;
    excitation = no.noise*en.ar(0.001,0.001,gate);
};


//-----------------------------------`(sy.)additiveDrum`---------------------------------------
// A simple drum using additive synthesis.
// `additiveDrum` is a standard Faust function.
//
// #### Usage
//
// ```
// additiveDrum(freq,freqRatio,gain,harmDec,att,rel,gate) : _
// ```
//
// Where:
//
// * `freq`: the resonance frequency of the drum in Hz
// * `freqRatio`: a list of ratio to choose the frequency of the mode in
//                function of `freq` e.g.(1 1.2 1.5 ...). The first element should always
//                be one (fundamental).
// * `gain`: the gain of each mode as a list (1 0.9 0.8 ...). The first element
//           is the gain of the fundamental.
// * `harmDec`: harmonic decay ratio (0-1): configure the speed at which
//              higher modes decay compare to lower modes.
// * `att`: attack duration in second
// * `rel`: release duration in second
// * `gate`: trigger signal (0 or 1)
//
// #### Test
// ```
// sy = library("synths.lib");
// additiveDrum_test = sy.additiveDrum(
//     hslider("additiveDrum:freq", 180, 60, 600, 1),
//     (1, 1.3, 2.4, 3.2),
//     (1, 0.8, 0.6, 0.4),
//     hslider("additiveDrum:harmDec", 0.4, 0, 1, 0.01),
//     0.01,
//     0.4,
//     button("additiveDrum:gate")
// );
// ```
//----------------------------------------------------------------------------------------
declare additiveDrum author "Romain Michon";

additiveDrum(freq,freqRatio,gain,harmDec,att,rel,gate) = par(i,N,os.osc(modeFreq(i))*gainEnvelope(i)) :> _
with {
    N = ba.count(freqRatio);
    modeFreq(i) = freq*ba.take(i+1,freqRatio);
    modeGain(i) = ba.take(i+1,gain);
    gainEnvelope(i) = modeGain(i)*en.ar(att,rel*(1-(harmDec*(i/N))),gate);
};


//-----------------------------------`(sy.)fm`---------------------------------------
// An FM synthesizer with an arbitrary number of modulators connected as a sequence.
// `fm` is a standard Faust function.
//
// #### Usage
//
// ```
// freqs = (300,400,...);
// indices = (20,...);
// fm(freqs,indices) : _
// ```
//
// Where:
//
// * `freqs`: a list of frequencies where the first one is the frequency of the carrier
//            and the others, the frequency of the modulator(s)
// * `indices`: the indices of modulation (Nfreqs-1)
//
// #### Test
// ```
// sy = library("synths.lib");
// fm_test = sy.fm((220, 440, 660), (1.5, 0.8));
// ```
//----------------------------------------------------------------------------------------
declare fm author "Romain Michon";

fm(freqs,indices) = seq(i,N,fmBlock(i))
with {
    N = ba.count(freqs);
    freq(i) = ba.take(N-i,freqs);
    gain(i) = ba.take(N-i,indices);
    fmBlock(0) = freq(0) : os.osc;
    fmBlock(i) = *(gain(i))+freq(i) : os.osc;
};

//-----------------------------------`(sy.)logicEFM1`---------------------------------------
// Model of one voice of Apple Logic Pro's EFM1, a two-operator FM synthesizer: a
// sine carrier phase-modulated by a modulator whose waveform morphs through ten
// wavetables, with volume and modulation envelopes, a key-synced LFO, a sub
// oscillator, carrier stereo detune and a unison mode. Stereo output.
//
// EFM1 exists only inside Logic Pro, so it cannot be hosted outside it. The model
// was reverse-engineered from single notes rendered by Logic at 48 kHz, each with
// one or two controls changed from a neutral patch and every control value read
// back from Logic. The laws and constants below were fitted to those renders, and
// the wavetables were read out of them. Against 94 of these renders the model
// matches the level to 0.03 dB and, for steady tones, the waveform to 0.7 %
// (median) and 4.4 % (worst case). The implementation notes give the fit per
// feature and list what was not measured: only 48 kHz, only C notes (C0 to C6),
// and one or a few settings for several controls.
//
// #### Usage
//
// ```
// logicEFM1(modHarm, carHarm, modFine, carFine, fixedCar, fmInt, modWave,
//           modEnvFM, modPitch, subLevel, stereoDet, unison,
//           lfoAmt, lfoRate, velAmt, mainLevel,
//           vA, vD, vS, vR, mA, mD, mS, mR,
//           freq, gate, gain) : _,_
// ```
//
// Where:
//
// * `modHarm`: modulator harmonic, an integer >= 1 (modulator frequency = modHarm*freq)
// * `carHarm`: carrier harmonic, an integer >= 0 (carrier frequency = carHarm*freq; 0 gives a 0 Hz carrier)
// * `modFine`: modulator fine ratio offset (-0.5..0.5), added to modHarm
// * `carFine`: carrier fine ratio offset (-0.5..0.5), added to carHarm
// * `fixedCar`: Fixed Carrier switch (0/1): the carrier sits at C1 (32.70 Hz) times its ratio, independent of freq and the LFO
// * `fmInt`: FM intensity (0-1)
// * `modWave`: modulator waveform (0-9): 0 is a sine, and the knob blends the ten wavetables linearly
// * `modEnvFM`: modulation envelope to FM intensity (-1..1)
// * `modPitch`: modulation envelope to modulator pitch (-1..1; up to +-27.5 semitones)
// * `subLevel`: sub oscillator level (0-1; a sine one octave below freq)
// * `stereoDet`: carrier stereo detune as displayed (0-50; the carriers move by about 0.75x this many cents)
// * `unison`: Unison switch (0/1): a second, slightly detuned copy of the voice
// * `lfoAmt`: LFO amount, bipolar (-1 = full vibrato, +-36 semitones .. +1 = full FM modulation)
// * `lfoRate`: LFO rate in Hz (0.01-100)
// * `velAmt`: velocity sensitivity of the level (0-1)
// * `mainLevel`: output gain (linear; 1 = Logic's 0 dB)
// * `vA`: volume envelope attack in ms, as Logic displays it (0-10000)
// * `vD`: volume envelope decay in ms (0-10000)
// * `vS`: volume envelope sustain (0-1)
// * `vR`: volume envelope release in ms (0-10000)
// * `mA`: modulation envelope attack in ms (0-10000)
// * `mD`: modulation envelope decay in ms (0-10000)
// * `mS`: modulation envelope sustain (0-1)
// * `mR`: modulation envelope release in ms (0-10000)
// * `freq`: note frequency in Hz
// * `gate`: note gate (0/1)
// * `gain`: note velocity (MIDI velocity/127)
//
// #### Test
// ```
// sy = library("synths.lib");
// ba = library("basics.lib");
// logicEFM1_test = sy.logicEFM1(1, 2, 0, 0, 0, 0.3, 2.5, 0.5, 0.2, 0.3, 10, 0,
//                               -0.3, 2, 0.3, 1, 10, 500, 0.7, 300, 0, 800, 0.2, 200,
//                               261.63, ba.time < 36000, 0.8);
// logicEFM1_unison_test = sy.logicEFM1(3, 4, 0, 0, 1, 0.35, 8.9, 0.7, 0, 0.2, 35, 1,
//                                      0.8, 1, 0.8, 1, 5, 1200, 0.3, 500, 0, 2000, 0.1, 400,
//                                      261.63, ba.time < 36000, 0.8);
// ```
//
// #### References
//
// * Apple, Logic Pro User Guide, "EFM1".
//------------------------------------------------------------------------------
/*
Implementation Notes:

Measured laws (Logic Pro renders at 48 kHz; control values as Logic displays them):

- Frequencies: carrier = (carHarm + carFine)*freq, modulator = (modHarm + modFine)
  *freq; carHarm 0 is a literal 0 Hz carrier, so the output is sin(beta*modulator).
  Fixed Carrier pins the carrier at 32.7036 Hz*(carHarm + carFine), exempt from freq
  and the LFO. All oscillators start at phase 0 on the note's first sample (the
  model restarts them at every note-on; repeated notes were not measured).
- FM index (radians): beta = 19.6*x^2 with x = |fmInt + amount^2*lfo +
  0.764*modEnvFM*modEnv|. The LFO and the envelope add to the FM Intensity input
  and the sum's sign folds; the cap at 40 is a numeric guard only.
- Modulator: ten tables, each a sine series of up to 128 harmonics (all sine
  terms, signed), peak-normalized to 1; table 1 is a triangle wave (1.092/k^2 on
  odd k, up to k = 31). modWave blends adjacent tables linearly. Harmonic k is
  played only while k*freq stays below about 17 kHz: 128 harmonics at C2 and
  below, 64 at C4, 16 at C6. Harmonics 1-64 were read at C4 and 65-128 at C2.
  Logic's own tables also show faint lookup images (about -70 dB, at harmonics
  385-640), which are not modeled.
- Envelopes: the attack follows (1 - exp(-2.4*t/T))/(1 - exp(-2.4)) and reaches 1
  at the displayed time T; decay and release are exponential with a T60 of 3x the
  displayed time. The modulator pitch envelope follows only the decaying part of
  the modulation envelope, (modEnv - sustain), up to +-27.5 semitones.
- LFO: a triangle, key-synced to start at its peak. Negative amounts give vibrato
  of the whole voice, up to +-36.07 semitones; the vibrato and the modulator pitch
  amount share one taper, a break-point curve measured at eight amounts.
- Level: output gain 0.3776*mainLevel*(1 + velAmt*(gain - 1)); sub oscillator
  amplitude subLevel^2 before that gain.
- Stereo: with detune, the carriers move by -0.7511x and +0.7497x the displayed
  cents (minus 0.01 cent) and the level drops to 2/3, in a step from zero detune.
  Unison adds a second copy of the voice (+0.279 and -2.421 cents). Placement:
  without detune, copy A left and copy B right at 4/3; with detune, the outer
  carriers (A down, B up) hard left and right at 2/3 and, with Unison, the inner
  two (A up, B down) in both channels at 1/2 (measured 1.333, 0.663 and 0.497).

Goodness of fit against 94 renders, level-matched relative RMS waveform error over
0.3-1.5 s of each note, and level error:

| Feature (captures)                                           | Waveform  | Level   |
|--------------------------------------------------------------|-----------|---------|
| Wavetable readouts, carrier 0, FM 0.1, C4, waves 0-9 (10)    | 0.2-3.0 % | 0.00 dB |
| Wavetable readouts at C0-C2 (12), see below                  | 0.4-5.2 % | 0.00 dB |
| Every table and blend in FM, carrier 1-2, FM 0.19-0.5 (13)   | 0.2-4.4 % | 0.03 dB |
| Sine modulator, FM 0.19-1.0, modulator 1-3 (4)               | 0.1-4.2 % | 0.02 dB |
| Modulation envelope to FM, depth -0.5..1, attack 300 ms (12) | 0.0-1.7 % | 0.02 dB |
| LFO to FM, amounts 0.25-1 (5)                                | 0.2-4.1 % | 0.02 dB |
| Modulation envelope to modulator pitch, +-0.25..0.5 (4)      | 0.2-1.9 % | 0.02 dB |
| Stereo detune 1-50, Unison, both (8)                         | 0.1-3.5 % | 0.02 dB |
| Sub oscillator, velocity sensitivity, velocity (7)           | 0.1 %     | 0.02 dB |
| Volume attack 300 ms, decay to sustain 0.5 (2)               | 0.1 %     | 0.02 dB |
| Fixed carrier, fine ratios (3)                               | 0.4-1.8 % | 0.02 dB |
| Other notes: C2, C5, C6 (3)                                  | 0.6-2.7 % | 0.02 dB |

For vibrato (amounts 0.12-1, 8 renders) and the full-scale modulator pitch envelope
(3 renders) the pitch is compared instead: median error 0.03-3.1 cents, largest
8.5 cents at full vibrato depth. Part of each waveform error comes from the
single-precision phase accumulator, which is off by 0.002 cents at C4 and
0.016 cents at C2 (far below audibility, but the phase drift adds up over a
second): at FM 1.0 an exact double-precision rendering of the model differs from
Logic by 2.7 %, against 4.2 % for the model as compiled, and for the C2 wave 8
readout 0.7 % against 5.2 %.

Not measured, or measured at only a few settings:

- Sample rates other than 48 kHz. Whether the 17 kHz harmonic limit, or anything
  else, follows the sample rate is unknown.
- Notes other than C0, C1, C2, C4, C5 and C6. Because these are octaves apart,
  whether the harmonic limit is a fixed 17 kHz or changes in octave steps (tables
  of 128, 64, 32 and 16 harmonics) is not resolved.
- The wavetables were read at C4 and C2 with a 0 Hz carrier and a low index.
  Each table, and blends at positions 0.5, 2.5, 4.5, 6.5 and 8.5, was then
  checked in FM (carrier 2, FM 0.3 or as listed above), but blends were not
  swept finely.
- Envelope times: attack 300 ms, decays 500 and 780 ms and the default release
  (72 ms) only. The modulator pitch envelope during release (below the sustain
  level) was not measured.
- The LFO rate at 2 Hz only; the vibrato taper is linear between its break points;
  the LFO FM taper (amount^2) was measured at four amounts.
- Fine ratios at one combination; carHarm 0 with carFine; the sub oscillator,
  Fixed Carrier or the modulator pitch envelope combined with Unison.
- Not modeled: polyphony and voice stealing, Glide, Randomize, the mono modes,
  Tune and Transpose, and the modulation-wheel routings.
*/
declare logicEFM1 author "David Braun";
declare logicEFM1 license "MIT";

logicEFM1(modHarm, carHarm, modFine, carFine, fixedCar, fmInt, modWave,
          modEnvFM, modPitch, subLevel, stereoDet, unison,
          lfoAmt, lfoRate, velAmt, mainLevel,
          vA, vD, vS, vR, mA, mD, mS, mR,
          freq, gate, gain) = (left, right) : (_*outVol, _*outVol)
with {
    // Envelopes (times in displayed ms). The attack is a one-pole rise toward
    // 1/(1 - exp(-2.4)) that reaches 1 at exactly the attack time; decay and release
    // are exponential with a T60 of 3x the displayed time.
    noteOn = gate > gate';
    volEnv = adsr(vA, vD, vS, vR);
    modEnv = adsr(mA, mD, mS, mR);
    adsr(aMs, dMs, sus, rMs) = (step ~ (_, _)) : (_, !)
    with {
        rate(t, n) = 1.0 - exp(0 - n/max(1.0, t*ma.SR));
        step(yp, dp) = y, done
        with {
            done = select2(noteOn, max(dp, yp >= 1.0) * (gate > 0), 0);
            attack = (gate > 0) * (done == 0);
            k = select2(gate > 0, rate(rMs*0.003, 6.9078),
                select2(attack, rate(dMs*0.003, 6.9078), rate(aMs*0.001, 2.4)));
            target = select2(gate > 0, 0.0, select2(attack, sus, 1.0/(1.0 - exp(-2.4))));
            yn = yp + (target - yp)*k;
            y = select2(attack, yn, min(yn, 1.0)) * (yn > 1e-20); // flush denormals
        };
    };

    // Taper shared by the vibrato and modulator-pitch amounts: break points
    // measured at amounts 0.12-1 (as a fraction of full scale), linear in between.
    amtCurve = ba.bpf.start(0, 0) : ba.bpf.point(0.12, 0.00649) : ba.bpf.point(0.25, 0.02257)
        : ba.bpf.point(0.38, 0.06946) : ba.bpf.point(0.5, 0.15281) : ba.bpf.point(0.62, 0.23613)
        : ba.bpf.point(0.75, 0.32644) : ba.bpf.point(0.88, 0.66669) : ba.bpf.end(1, 1);

    // Key-synced triangle LFO starting at its peak. The two sides of the amount
    // knob have different laws: vibrato up to +-3606.5 cents through amtCurve, and
    // an FM depth of amount^2.
    lfoPh = (+(lfoRate/ma.SR) : ma.frac) ~ (*(1.0 - noteOn));
    lfoTri = 1.0 - 4.0*abs(ma.frac(lfoPh + 0.5) - 0.5);
    vibCents = 3606.5 * amtCurve(max(0.0, 0 - lfoAmt));
    fmLfo = pow(max(0.0, lfoAmt), 2.0);

    // Frequencies: vibrato (whole voice) and the modulator pitch envelope, which
    // follows only the decaying part of the modulation envelope (modEnv - sustain)
    // with up to +-27.5 semitones; Fixed Carrier ignores freq and vibrato.
    vibMod = pow(2.0, vibCents*lfoTri/1200.0);
    pitchSemis = 27.5 * amtCurve(abs(modPitch)) * ma.signum(modPitch) * (modEnv - mS);
    modPitchRatio = pow(2.0, pitchSemis/12.0);
    fc = select2(fixedCar > 0.5, freq * vibMod, 32.7036) * (carHarm + carFine);
    fm = freq * (modHarm + modFine) * vibMod * modPitchRatio;

    // FM index: the LFO and the modulation envelope add to the FM Intensity input,
    // and one curve maps the sum (its sign folds) to the index in radians.
    betaCurve(x) = min(40.0, 19.6 * x * x);
    beta = betaCurve(fmInt + fmLfo*lfoTri + 0.764*modEnvFM*modEnv);

    // Every oscillator restarts at phase 0 on each note-on (measured for single
    // notes; where sidebands fold, the relative phase sets their balance).
    phasor(f) = (+(f/ma.SR) : ma.decimal) ~ (*(1.0 - noteOn));

    // Modulator: a sine series. Its 128 coefficients are blended linearly between
    // the two measured tables adjacent to modWave (see the implementation notes),
    // harmonics above 17 kHz (or Nyquist) are dropped, and sin(k*th) is generated by
    // rotating (cos, sin) through th once per harmonic (stable in single precision).
    nH = 128;
    wPos = max(0.0, min(9.0, modWave));
    wLo = int(wPos);
    wHi = min(9, wLo + 1);
    wFrac = wPos - wLo;
    coef(j, k) = rdtable(tables, int(j*nH + k - 1));
    blend(k) = coef(wLo, k) + wFrac*(coef(wHi, k) - coef(wLo, k));
    modOsc(f) = (0.0, 1.0, 0.0) : seq(i, nH, step(i + 1)) : (_, !, !)
    with {
        th = 2.0*ma.PI*phasor(f);
        c1 = cos(th);
        s1 = sin(th);
        step(k, acc, ck, sk) = acc + blend(k)*(k*f < min(17000.0, 0.5*ma.SR))*sn, cn, sn
        with {
            cn = ck*c1 - sk*s1;
            sn = sk*c1 + ck*s1;
        };
    };
    carrier(f, modsig) = sin(2.0*ma.PI*phasor(f) + beta*modsig);

    // Stereo detune moves the carrier down (dn) and up (up) by about 0.75x the
    // displayed cents. Unison adds a second copy of the voice: copy A at +0.28 cents,
    // copy B at -2.42 cents (without Unison both are the plain voice). Stereo placement:
    // - no detune: A left and B right, each x4/3 with Unison;
    // - detune: A dn hard left and B up hard right, each x2/3; with Unison, A up and
    //   B dn are also mixed into both channels, x1/2 each.
    detOn = stereoDet > 0.0;
    uniOn = unison > 0.5;
    detDn = ba.semi2ratio((-0.7511*stereoDet - 0.0095*detOn)/100.0);
    detUp = ba.semi2ratio((0.7497*stereoDet - 0.0095*detOn)/100.0);
    uA = select2(uniOn, 1.0, ba.semi2ratio(0.279/100.0));
    uB = select2(uniOn, 1.0, ba.semi2ratio(-2.421/100.0));
    outerGain = select2(detOn, select2(uniOn, 1.0, 4.0/3.0), 2.0/3.0);
    innerGain = select2(detOn & uniOn, 0.0, 0.5);
    modA = modOsc(fm*uA);
    modB = modOsc(fm*uB);
    inner = innerGain * (carrier(fc*detUp*uA, modA) + carrier(fc*detDn*uB, modB));
    sub = sin(2.0*ma.PI*phasor(freq*0.5)) * subLevel * subLevel;
    left = outerGain*carrier(fc*detDn*uA, modA) + inner + sub;
    right = outerGain*carrier(fc*detUp*uB, modB) + inner + sub;
    velVol = it.interpolate_linear(velAmt, 1.0, gain);
    outVol = 0.3776 * mainLevel * velVol * volEnv;

