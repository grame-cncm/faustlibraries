declare phasor_imp deprecated "internal machinery, renamed _phasor_imp";
phasor_imp = _phasor_imp;
declare phasor_table deprecated "internal machinery, renamed _phasor_table";
phasor_table = _phasor_table;
declare MAX_SAW_ORDER_NEXTPOW2 deprecated "internal constant, renamed _MAX_SAW_ORDER_NEXTPOW2";
MAX_SAW_ORDER_NEXTPOW2 = _MAX_SAW_ORDER_NEXTPOW2;
