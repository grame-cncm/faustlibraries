ba = library("basics.lib");
ma = library("maths.lib");

declare name "MaxMSP compatibility Library";
declare author "GRAME";
declare copyright "GRAME";
declare version "1.1.0";
declare license "LicenseRef-LGPL-2.1-or-later-with-Faust-exception";

//---------------------------`atodb`--------------------------------
// Convert a linear amplitude to a level in dB, as the MaxMSP `atodb`
// object.
//
// #### Usage
//
// ```
// _ : atodb : _
// ```
//
// #### Test
// ```
// mm = library("maxmsp.lib");
// mm_atodb_test = 0.5 : mm.atodb;
// ```
//----------------------------------------------------------
atodb = ba.linear2db;

//---------------------------`filtercoeff`--------------------------------
// Implementation of MaxMSP filtercoeff: an environment holding the
// biquad coefficient sets (`a0,a1,a2,b1,b2`, normalized and ready for
// `biquad`) of the filters below, computed from the Cookbook formulae
// for audio EQ biquad filter coefficients by Robert Bristow-Johnson.
//
// #### Usage
//
// ```
// filtercoeff(f0, dBgain, Q).LPF // or .HPF, .BPF, .notch, .APF,
//                                // .peakingEQ, .peakNotch, .lowShelf, .highShelf
// ```
//
// Where:
//
// * `f0`: center/cutoff frequency in Hz
// * `dBgain`: gain in dB (used by the peaking and shelving filters)
// * `Q`: quality factor
//
// #### Test
// ```
// mm = library("maxmsp.lib");
// mm_filtercoeff_test = mm.filtercoeff(1000, 6, 1).LPF;
// ```
//
// #### References
//
// * <http://www.musicdsp.org/files/Audio-EQ-Cookbook.txt>
//----------------------------------------------------------

filtercoeff(f0, dBgain, Q) = environment
{
    //----------------------------------------
    // biquad coeffs for various filters
    // usage : filtercoeff(f0, dBgain, Q).LPF
    //----------------------------------------

    LPF = rbjcoef(a0, a1, a2, b0, b1, b2)
        with {
            b0 = (1 - cos(w0))/2;
            b1 =  1 - cos(w0);
            b2 = (1 - cos(w0))/2;
            a0 =  1 + alpha;
            a1 = -2*cos(w0);
            a2 =  1 - alpha;
        };

    HPF = rbjcoef(a0, a1, a2, b0, b1, b2)
        with {
            b0 = (1 + cos(w0))/2;
            b1 = -1 - cos(w0);
            b2 = (1 + cos(w0))/2;
            a0 =  1 + alpha;
            a1 = -2*cos(w0);
            a2 =  1 - alpha;
        };

    BPF = rbjcoef(a0, a1, a2, b0, b1, b2) // constant 0 dB peak gain
        with {
            b0 = alpha;
            b1 = 0;
            b2 = -alpha;
            a0 = 1 + alpha;
            a1 = -2*cos(w0);
            a2 = 1 - alpha;
        };

    notch = rbjcoef(a0, a1, a2, b0, b1, b2)
        with {
            b0 = 1;
            b1 = -2*cos(w0);
            b2 = 1;
            a0 = 1 + alpha;
            a1 = -2*cos(w0);
            a2 = 1 - alpha;
        };

    APF = rbjcoef(a0, a1, a2, b0, b1, b2)
        with {
            b0 = 1 - alpha;
            b1 = -2*cos(w0);
            b2 = 1 + alpha;
            a0 = 1 + alpha;
            a1 = -2*cos(w0);
            a2 = 1 - alpha;
        };

    peakingEQ = rbjcoef(a0, a1, a2, b0, b1, b2)
        with {
            b0 = 1 + alpha*A;
            b1 = -2*cos(w0);
            b2 = 1 - alpha*A;
            a0 = 1 + alpha/A;
            a1 = -2*cos(w0);
            a2 = 1 - alpha/A;
        };

    peakNotch = rbjcoef(a0, a1, a2, b0, b1, b2)
        with {
            b0 = 1 + alpha*G;
            b1 = -2*cos(w0);
            b2 = 1 - alpha*G;
            a0 = 1 + alpha/G;
            a1 = -2*cos(w0);
            a2 = 1 - alpha/G;
        };

    lowShelf = rbjcoef(a0, a1, a2, b0, b1, b2)
        with {
            b0 =   A*((A+1) - (A-1)*cos(w0) + 2*sqrt(A)*alpha);
            b1 = 2*A*((A-1) - (A+1)*cos(w0));
            b2 =   A*((A+1) - (A-1)*cos(w0) - 2*sqrt(A)*alpha);
            a0 =      (A+1) + (A-1)*cos(w0) + 2*sqrt(A)*alpha;
            a1 =  -2*((A-1) + (A+1)*cos(w0));
            a2 =      (A+1) + (A-1)*cos(w0) - 2*sqrt(A)*alpha;
        };

    highShelf = rbjcoef(a0, a1, a2, b0, b1, b2)
        with {
            b0 =    A*((A+1) + (A-1)*cos(w0) + 2*sqrt(A)*alpha);
            b1 = -2*A*((A-1) + (A+1)*cos(w0));
            b2 =    A*((A+1) + (A-1)*cos(w0) - 2*sqrt(A)*alpha);
            a0 =       (A+1) - (A-1)*cos(w0) + 2*sqrt(A)*alpha;
            a1 =    2*((A-1) - (A+1)*cos(w0));
            a2 =       (A+1) - (A-1)*cos(w0) - 2*sqrt(A)*alpha;
        };

    // --------------------- implementation ------------------------------

    // convert rbj coeffs to biquad coeffs
    rbjcoef(a0,a1,a2,b0,b1,b2) = (b0/a0, b1/a0, b2/a0, a1/a0, a2/a0);

    // common values
    alpha = sin(w0)/(2*max(0.001,Q));
    w0    = 2*ma.PI*max(0,f0)/Fs;
    Fs    = ma.SR;
    A     = 10^(dBgain/40);             // (for peaking and shelving EQ filters only)
    G     = sqrt(max(0.00001, dBgain)); // When gain is a linear values (i.e. not in dB)
};


//---------------------------`biquad`--------------------------------
// Implementation of MaxMSP biquad~:
// y[n] = a0 * x[n] + a1 * x[n-1] + a2 * x[n-2] - b1 * y[n-1] - b2 * y[n-2]
//
// #### Usage
//
// ```
// biquad(x,a0,a1,a2,b1,b2) : _
// ```
//
// Where:
//
// * `x`: the input signal
// * `a0,a1,a2`: feedforward coefficients
// * `b1,b2`: feedback coefficients
//
// #### Test
// ```
// mm = library("maxmsp.lib");
// os = library("oscillators.lib");
// mm_biquad_test = mm.biquad(os.osc(440), 0.5, 0.2, 0.1, 0.1, 0.05);
// ```
//----------------------------------------------------------
biquad(x,a0,a1,a2,b1,b2) =  x : + ~ ((-1)*conv2(b1, b2)) : conv3(a0, a1, a2)
    with {
        conv2(c0,c1,x) = c0*x+c1*x';
        conv3(c0,c1,c2,x) = c0*x+c1*x'+c2*x'';
    };

//---------------------------`LPF`, `HPF`, `BPF`, `notch`, `APF`--------------------------------
// Second-order lowpass, highpass, bandpass (constant 0 dB peak gain),
// notch and allpass filters, combining `filtercoeff` and `biquad`.
// The `gain` argument is ignored by these filter types; it is kept so
// all nine filters share the same signature.
//
// #### Usage
//
// ```
// LPF(x, f0, gain, Q) : _ // and likewise HPF, BPF, notch, APF
// ```
//
// Where:
//
// * `x`: the input signal
// * `f0`: center/cutoff frequency in Hz
// * `gain`: unused for these filter types
// * `Q`: quality factor
//
// #### Test
// ```
// mm = library("maxmsp.lib");
// os = library("oscillators.lib");
// mm_LPF_test = mm.LPF(os.osc(440), 1000, 0, 1);
// ```
//----------------------------------------------------------
LPF(x, f0, gain, Q)= x , filtercoeff(f0,gain,Q).LPF : biquad;
HPF(x, f0, gain, Q) = x , filtercoeff(f0,gain,Q).HPF : biquad;
BPF(x, f0, gain, Q) = x , filtercoeff(f0,gain,Q).BPF : biquad;
notch(x, f0, gain, Q)= x , filtercoeff(f0,gain,Q).notch : biquad;
APF(x, f0, gain, Q) = x , filtercoeff(f0,gain,Q).APF : biquad;

//---------------------------`peakingEQ`, `peakNotch`, `lowShelf`, `highShelf`--------------------------------
// Second-order peaking equalizer and shelving filters, combining
// `filtercoeff` and `biquad`. `peakNotch` is like `peakingEQ` but with a
// linear gain.
//
// #### Usage
//
// ```
// peakingEQ(x, f0, gain, Q) : _ // and likewise peakNotch, lowShelf, highShelf
// ```
//
// Where:
//
// * `x`: the input signal
// * `f0`: center frequency in Hz
// * `gain`: gain in dB (linear for `peakNotch`)
// * `Q`: quality factor
//
// #### Test
// ```
// mm = library("maxmsp.lib");
// os = library("oscillators.lib");
// mm_peakingEQ_test = mm.peakingEQ(os.osc(440), 1000, 6, 1);
// ```
//----------------------------------------------------------
peakingEQ(x, f0, gain, Q) = x , filtercoeff(f0,gain,Q).peakingEQ : biquad;
peakNotch(x, f0, gain, Q) = x , filtercoeff(f0,gain,Q).peakNotch : biquad;
lowShelf(x, f0, gain, Q) = x , filtercoeff(f0,gain,Q).lowShelf : biquad;
highShelf(x, f0, gain, Q) = x , filtercoeff(f0,gain,Q).highShelf : biquad;


//---------------------------`line`--------------------------------
// Implementation of Max/MSP line~. Generate a signal ramp or envelope.
//
// Note that the interpolation process is restarted every time the
// desired output value changes. The interpolation time is sampled only
// then.
//
// #### Usage
//
// ```
// line(value, time) : _
// ```
//
// Where:
//
// * `value`: the desired output value
// * `time`: the interpolation time to reach this value (in milliseconds)
//
// #### Test
// ```
// mm = library("maxmsp.lib");
// mm_line_test = mm.line(hslider("value", 0, 0, 1, 0.01), 100);
// ```
//----------------------------------------------------------
line(value, time) = state~(_,_):!,_
    with {
        state(t, c) = nt,nc 
        with {
            nt = ba.if(value != value', samples, t-1);
            nc = ba.if(nt > 0, c + (value - c)/nt, value);
            samples = time*ma.SR/1000.0;
        };
    };
