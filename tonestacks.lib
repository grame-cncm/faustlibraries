//#################################### tonestacks.lib ########################################
// A library of guitar amplifier tone stack emulations, from the Guitarix
// project, based on the circuit analysis of D.T. Yeh (some component values
// taken from the CAPS plugin suite). Each model is the classic passive
// treble/middle/bass network of a well-known amplifier, discretized by
// bilinear transform from its schematic component values.
//
// The models are normally used through their own namespace:
//
// ```
// ts = library("tonestacks.lib");
// process = ts.jcm2000(t,m,l);
// ```
//
// #### References
//
// * <https://github.com/grame-cncm/faustlibraries/blob/master/tonestacks.lib>
// * D.T. Yeh and J.O. Smith, "Discretization of the '59 Fender Bassman Tone
//   Stack", Proc. of the 9th Int. Conference on Digital Audio Effects (DAFx-06).
//########################################################################################

/**
 **  Guitar tone stacks (based on the work from D.T. Yeh)
 **  some values are taken from CAPS plugin tonestack 
 ** 
 **  this tonestacks.library provide the following tonestack models:
 **  bassman, mesa, twin, princeton, jcm800, jcm2000, jtm45, mlead,
 **  m2199, ac30, ac15, soldano, sovtek, peavey, ibanez, roland, 
 **  ampeg, ampeg_rev, bogner, groove, crunch, fender_blues,
 **  fender_default, fender_deville, gibsen
 **  
 **  USAGE :
 **        _:component("tonestacks.lib").model(t,m,l):_
 **  WHERE :
 **       model is on of the models above.
 **       t is treble freq control in range of (0.0 - 1.0)
 **       m is middle freq control in range of (0.0 - 1.0)
 **       l is low freq control in range of (0.0 - 1.0)
 ** 
 **  EXAMPLE :
 **       process = component("tonestacks.lib").jcm2000(t,m,l) 
 **       with {
 **         t = vslider("Treble ", 0.5, 0, 1, 0.01);
 **         m = vslider("Middle ", 0.5, 0, 1, 0.01);
 **         l = vslider("Bass ", 0.5, 0, 1, 0.01);
 **       };
 **/

ma = library("maths.lib");

declare name      "Faust Tonestack Emulation Library";
declare author    "Guitarix project (<http://guitarix.sourceforge.net/>)";
declare copyright "Guitarix project";
declare version   "1.28.3";
declare license   "LGPL-2.1-or-later";

/****************************************************************
 **           Equalisation 3 bands
 **                    C1
 **       IN >---------||---------
 **            |                 |
 **            |                 |
 **           | | R4            | | R1 Treble
 **           | |               | |<------<  Out
 **           | |               | | 
 **            |       C2        |
 **            |-------||--------|------
 **            |                 |     |
 **            |                | |    |
 **            |                | |<---- R2 Bass
 **            |                | |
 **            |                 |
 **            |       C3       | |
 **            --------||------>| |  R3 Middle
 **                             | |
 **                              |
 **                             _|_
 **                              -
 **
 ****************************************************************/

//---------------------------`tonestack`--------------------------------
// Generic tone stack: computes the bilinear-transformed transfer function
// of the classic passive treble/middle/bass network from its schematic
// component values. All the amplifier models below are instances of this
// function with measured component values. The filter is realized with
// trapezoidal integrators in observable canonical form, which stays accurate
// in single precision up to 192 kHz and keeps the output continuous when the
// controls move.
//
// #### Usage
//
// ```
// _ : tonestack(C1,C2,C3,R1,R2,R3,R4,t,m,l) : _
// ```
//
// Where:
//
// * `C1`, `C2`, `C3`: capacitor values of the network, in Farads
// * `R1`, `R2`, `R3`, `R4`: resistor values of the network, in Ohms
// * `t`: treble control, between 0 and 1
// * `m`: middle control, between 0 and 1
// * `l`: bass control, between 0 and 1
//
// #### Test
// ```
// ts = library("tonestacks.lib");
// no = library("noises.lib");
// tonestack_test = no.noise : ts.tonestack(250e-12, 20e-9, 20e-9, 250e3, 1e6, 25e3, 56e3, 0.5, 0.5, 0.5);
// ```
//
//----------------------------------------------------------
tonestack(C1,C2,C3,R1,R2,R3,R4,t,m,L) = tick ~ (_,_,_) : !,!,!,_
    with {
    
    l = L : (_-1)*3.4 : exp;
    
    b1 = t*C1*R1 + m*C3*R3 + l*(C1*R2 + C2*R2) + (C1*R3 + C2*R3);

    b2 = t*(C1*C2*R1*R4 + C1*C3*R1*R4) - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
         + m*(C1*C3*R1*R3 + C1*C3*R3*R3 + C2*C3*R3*R3)
         + l*(C1*C2*R1*R2 + C1*C2*R2*R4 + C1*C3*R2*R4)
         + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
         + (C1*C2*R1*R3 + C1*C2*R3*R4 + C1*C3*R3*R4);

    b3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
         - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
         + m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
         + t*C1*C2*C3*R1*R3*R4 - t*m*C1*C2*C3*R1*R3*R4
         + t*l*C1*C2*C3*R1*R2*R4;

    a0 = 1;

    a1 = (C1*R1 + C1*R3 + C2*R3 + C2*R4 + C3*R4)
         + m*C3*R3 + l*(C1*R2 + C2*R2);

    a2 = m*(C1*C3*R1*R3 - C2*C3*R3*R4 + C1*C3*R3*R3 + C2*C3*R3*R3)
         + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
         - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
         + l*(C1*C2*R2*R4 + C1*C2*R1*R2 + C1*C3*R2*R4 + C2*C3*R2*R4)
         + (C1*C2*R1*R4 + C1*C3*R1*R4 + C1*C2*R3*R4 + C1*C2*R1*R3 + C1*C3*R3*R4 + C2*C3*R3*R4);

    a3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
         - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
         + m*(C1*C2*C3*R3*R3*R4 + C1*C2*C3*R1*R3*R3 - C1*C2*C3*R1*R3*R4)
         + l*C1*C2*C3*R1*R2*R4
         + C1*C2*C3*R1*R3*R4;

    // H(s) = (b3*s^3 + b2*s^2 + b1*s)/(a3*s^3 + a2*s^2 + a1*s + a0), discretized by the
    // bilinear transform (c = 2*SR) as trapezoidal integrators I[] in observable canonical
    // form: y = b3/a3*x + z1, z1 = I[(b2*x - a2*y)/a3 + z2], z2 = I[(b1*x - a1*y)/a3 + z3],
    // z3 = I[-a0*y/a3], with the integrators normalized by w. The first state follows the
    // output, so the output stays continuous when the knobs move the numerator and the
    // denominator together. A direct form (fi.iir) clusters its poles near z = 1 and
    // fails in single precision at high sampling rates.
    // An RC network has real negative poles, so w = a2/a3 = |p1| + |p2| + |p3| is between
    // the largest pole magnitude and 3 times it: the frequency scale of the integrators.
    r2 = 1/a2 : min(ma.MAX); // reciprocals (min keeps Faust from turning x*r back into x/c)
    r3 = 1/a3 : min(ma.MAX);
    rw = a3*r2; // 1/w
    g  = a2*r3*0.5/ma.SR; // w/(2*SR): trapezoidal integrators of s/w
    al1 = a1*r2*rw; al0 = a0*r2*rw*rw; // a1/(a3*w^2), a0/(a3*w^3); a2/(a3*w) = 1
    be3 = b3*r3; be2 = b2*r2; be1 = b1*r2*rw;
    dn = 1/(1 + g*(1 + g*(al1 + g*al0))) : min(ma.MAX);
    nx = be3 + g*(be2 + g*be1);
    tick(s1, s2, s3, x) = 2*z1 - s1, 2*z2 - s2, 2*z3 - s3, y
    with {
        y  = (nx*x + s1 + g*(s2 + g*s3))*dn;
        z3 = s3 - g*al0*y;
        z2 = g*(be1*x - al1*y + z3) + s2;
        z1 = g*(be2*x - y + z2) + s1;
    };
};

ts = environment {
    k = *(1e3);
    M = *(1e6);
    nF = *(1e-9);
    pF = *(1e-12);

    /* Fender */

    bassman = environment { /* 59 Bassman 5F6-A */
        R1 = 250:k;
        R2 = 1:M;
        R3 = 25:k;
        R4 = 56:k;
        C1 = 250:pF;
        C2 = 20:nF;
        C3 = 20:nF;
        };
        
    mesa = environment { /* Mesa Boogie Mark */
        R1 = 250:k;
        R2 = 250:k;
        R3 = 25:k;
        R4 = 100:k;
        C1 = 250:pF;
        C2 = 100:nF;
        C3 = 47:nF;
        };
        
    twin = environment { /* 69 Twin Reverb AA270 */
        R1 = 250:k;
        R2 = 250:k;
        R3 = 10:k;
        R4 = 100:k;
        C1 = 120:pF;
        C2 = 100:nF;
        C3 = 47:nF;
        };

    princeton = environment { /* 64 Princeton AA1164 */
        R1 = 250:k;
        R2 = 250:k;
        R3 = 4.8:k;
        R4 = 100:k;
        C1 = 250:pF;
        C2 = 100:nF;
        C3 = 47:nF;
        };

    /* Marshall */

    jcm800 = environment { /* 59/81 JCM-800 Lead 100 2203 */
        R1 = 220:k;
        R2 = 1:M;
        R3 = 22:k;
        R4 = 33:k;
        C1 = 470:pF;
        C2 = 22:nF;
        C3 = 22:nF;
        };
        
    /* 90 JCM-900 Master 2100: same as JCM-800 */

    jcm2000 = environment { /* 81 2000 Lead */
        R1 = 250:k;
        R2 = 1:M;
        R3 = 25:k;
        R4 = 56:k; /* a 10 k fixed + 100 k pot in series actually */
        C1 = 500:pF;
        C2 = 22:nF;
        C3 = 22:nF;
        };
        
    jtm45 = environment { /* JTM 45 */
        R1 = 250:k;
        R2 = 1:M;
        R3 = 25:k;
        R4 = 33:k; 
        C1 = 270:pF;
        C2 = 22:nF;
        C3 = 22:nF;
        };

    /* parameter order is R1 - R4, C1 - C3 */
    mlead = environment { /* 67 Major Lead 200 */
        R1 = 250:k;
        R2 = 1:M;
        R3 = 25:k;
        R4 = 33:k;
        C1 = 500:pF;
        C2 = 22:nF;
        C3 = 22:nF;
        };

    m2199 = environment { /* undated M2199 30W solid state */
        R1 = 250:k;
        R2 = 250:k;
        R3 = 25:k;
        R4 = 56:k;
        C1 = 250:pF;
        C2 = 47:nF;
        C3 = 47:nF;
        };

    /* Vox */
    ac30 = environment { /* 59/86 AC-30 */
        /* R3 is fixed (circuit differs anyway) */
        R1 = 1:M;
        R2 = 1:M;
        R3 = 10:k;
        R4 = 100:k;
        C1 = 50:pF;
        C2 = 22:nF;
        C3 = 22:nF;
        };
        
    ac15 = environment { /* VOX AC-15 */
        R1 = 220:k;
        R2 = 220:k;
        R3 = 220:k;
        R4 = 100:k;
        C1 = 470:pF;
        C2 = 100:nF;
        C3 = 47:nF;
        };
        
    soldano = environment { /* Soldano SLO 100 */
        R1 = 250:k;
        R2 = 1:M;
        R3 = 25:k;
        R4 = 47:k;
        C1 = 470:pF;
        C2 = 20:nF;
        C3 = 20:nF;
        };
        
    sovtek = environment { /* MIG 100 H*/
        R1 = 500:k;
        R2 = 1:M;
        R3 = 10:k;
        R4 = 47:k;
        C1 = 470:pF;
        C2 = 22:nF;
        C3 = 22:nF;
        };

    peavey = environment { /* c20*/
        R1 = 250:k;
        R2 = 250:k;
        R3 = 20:k;
        R4 = 68:k;
        C1 = 270:pF;
        C2 = 22:nF;
        C3 = 22:nF;
        };
        
    ibanez = environment { /* gx20 */
        R1 = 250:k;
        R2 = 250:k;
        R3 = 10:k;
        R4 = 100:k;
        C1 = 270:pF;
        C2 = 100:nF;
        C3 = 40:nF;
        };
        
    roland = environment { /* Cube 60 */
        R1 = 250:k;
        R2 = 250:k;
        R3 = 10:k;
        R4 = 41:k;
        C1 = 240:pF;
        C2 = 33:nF;
        C3 = 82:nF;
        };
        
    ampeg = environment { /* VL 501 */
        R1 = 250:k;
        R2 = 1:M;
        R3 = 25:k;
        R4 = 32:k;
        C1 = 470:pF;
        C2 = 22:nF;
        C3 = 22:nF;
        };
    
    ampeg_rev = environment { /* reverbrocket*/
        R1 = 250:k;
        R2 = 250:k;
        R3 = 10:k;
        R4 = 100:k;
        C1 = 100:pF;
        C2 = 100:nF;
        C3 = 47:nF;
        };
        
    bogner = environment { /* Triple Giant Preamp  */
        R1 = 250:k;
        R2 = 1:M;
        R3 = 33:k;
        R4 = 51:k;
        C1 = 220:pF;
        C2 = 15:nF;
        C3 = 47:nF;
        };
        
    groove = environment { /* Trio Preamp  */
        R1 = 220:k;
        R2 = 1:M;
        R3 = 22:k;
        R4 = 68:k;
        C1 = 470:pF;
        C2 = 22:nF;
        C3 = 22:nF;
        };
        
    crunch = environment { /* Hughes&Kettner  */
        R1 = 220:k;
        R2 = 220:k;
        R3 = 10:k;
        R4 = 100:k;
        C1 = 220:pF;
        C2 = 47:nF;
        C3 = 47:nF;
        };
        
    fender_blues = environment { /* Fender blues junior  */
        R1 = 250:k;
        R2 = 250:k;
        R3 = 25:k;
        R4 = 100:k;
        C1 = 250:pF;
        C2 = 22:nF;
        C3 = 22:nF;
        };
        
    fender_default = environment { /* Fender   */
        R1 = 250:k;
        R2 = 250:k;
        R3 = 10:k;
        R4 = 100:k;
        C1 = 250:pF;
        C2 = 100:nF;
        C3 = 47:nF;
        };
        
    fender_deville = environment { /* Fender Hot Rod  */
        R1 = 250:k;
        R2 = 250:k;
        R3 = 25:k;
        R4 = 130:k;
        C1 = 250:pF;
        C2 = 100:nF;
        C3 = 22:nF;
        };
        
    gibsen = environment { /* gs12 reverbrocket   */
        R1 = 1:M;
        R2 = 1:M;
        R3 = 94:k;  // 47k fixed
        R4 = 270:k;
        C1 = 25:pF;
        C2 = 60:nF;
        C3 = 20:nF;
        };

};

//---------------------------`bassman`--------------------------------
// Tone stack of the 1959 Fender Bassman 5F6-A.
//
// #### Usage
//
// ```
// _ : bassman(t,m,l) : _
// ```
//
// Where:
//
// * `t`: treble control, between 0 and 1
// * `m`: middle control, between 0 and 1
// * `l`: bass control, between 0 and 1
//
// #### Test
// ```
// ts = library("tonestacks.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// no = library("noises.lib");
// bassman_test = no.noise : ts.bassman(0.5, 0.5, 0.5);
// bassman_slider_test = no.noise : ts.bassman(hslider("bassman:t", 0.5, 0, 1, 0.01), hslider("bassman:m", 0.5, 0, 1, 0.01), hslider("bassman:l", 0.5, 0, 1, 0.01));
// bassman_modulated_test = no.noise : ts.bassman(0.5, 0.5, tri) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// bassman_jump_test = no.noise : ts.bassman(0.5, 0.5, sq) with { P = int(ma.SR/10); sq = ba.period(2*P) < P; };
// bassman_middle_jump_test = no.noise : ts.bassman(0, sq, 1) with { P = int(ma.SR/10); sq = ba.period(2*P) < P; };
// ```
//
//----------------------------------------------------------
bassman(T,M,L) = tonestack(t.C1,t.C2,t.C3,t.R1,t.R2,t.R3,t.R4,T,M,L) 
                    with {t = ts.bassman;};
//---------------------------`mesa`--------------------------------
// Tone stack of the Mesa Boogie Mark.
//
// #### Usage
//
// ```
// _ : mesa(t,m,l) : _
// ```
//
// Where:
//
// * `t`: treble control, between 0 and 1
// * `m`: middle control, between 0 and 1
// * `l`: bass control, between 0 and 1
//
// #### Test
// ```
// ts = library("tonestacks.lib");
// no = library("noises.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// mesa_test = no.noise : ts.mesa(0.5, 0.5, 0.5);
// mesa_slider_test = no.noise : ts.mesa(hslider("mesa:t", 0.5, 0, 1, 0.01), hslider("mesa:m", 0.5, 0, 1, 0.01), hslider("mesa:l", 0.5, 0, 1, 0.01));
// mesa_modulated_test = no.noise : ts.mesa(0.5, tri, 0.5) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// mesa_jump_test = no.noise : ts.mesa(0.5, 0.5, sq) with { P = int(ma.SR/10); sq = ba.period(2*P) < P; };
// ```
//
//----------------------------------------------------------
mesa(T,M,L) = tonestack(t.C1,t.C2,t.C3,t.R1,t.R2,t.R3,t.R4,T,M,L) 
                    with {t = ts.mesa;};
//---------------------------`twin`--------------------------------
// Tone stack of the 1969 Fender Twin Reverb AA270.
//
// #### Usage
//
// ```
// _ : twin(t,m,l) : _
// ```
//
// Where:
//
// * `t`: treble control, between 0 and 1
// * `m`: middle control, between 0 and 1
// * `l`: bass control, between 0 and 1
//
// #### Test
// ```
// ts = library("tonestacks.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// no = library("noises.lib");
// twin_test = no.noise : ts.twin(0.5, 0.5, 0.5);
// twin_slider_test = no.noise : ts.twin(hslider("twin:t", 0.5, 0, 1, 0.01), hslider("twin:m", 0.5, 0, 1, 0.01), hslider("twin:l", 0.5, 0, 1, 0.01));
// twin_modulated_test = no.noise : ts.twin(0.5, tri, 0.5) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// twin_jump_test = no.noise : ts.twin(0.5, 0.5, sq) with { P = int(ma.SR/10); sq = ba.period(2*P) < P; };
// ```
//
//----------------------------------------------------------
twin(T,M,L) = tonestack(t.C1,t.C2,t.C3,t.R1,t.R2,t.R3,t.R4,T,M,L) 
                    with {t = ts.twin;};
//---------------------------`princeton`--------------------------------
// Tone stack of the 1964 Fender Princeton AA1164.
//
// #### Usage
//
// ```
// _ : princeton(t,m,l) : _
// ```
//
// Where:
//
// * `t`: treble control, between 0 and 1
// * `m`: middle control, between 0 and 1
// * `l`: bass control, between 0 and 1
//
// #### Test
// ```
// ts = library("tonestacks.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// no = library("noises.lib");
// princeton_test = no.noise : ts.princeton(0.5, 0.5, 0.5);
// princeton_slider_test = no.noise : ts.princeton(hslider("princeton:t", 0.5, 0, 1, 0.01), hslider("princeton:m", 0.5, 0, 1, 0.01), hslider("princeton:l", 0.5, 0, 1, 0.01));
// princeton_modulated_test = no.noise : ts.princeton(0.5, tri, 0.5) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// princeton_jump_test = no.noise : ts.princeton(0.5, 0.5, sq) with { P = int(ma.SR/10); sq = ba.period(2*P) < P; };
// ```
//
//----------------------------------------------------------
princeton(T,M,L) = tonestack(t.C1,t.C2,t.C3,t.R1,t.R2,t.R3,t.R4,T,M,L) 
                    with {t = ts.princeton;};
//---------------------------`jcm800`--------------------------------
// Tone stack of the Marshall JCM-800 Lead 100 (model 2203).
//
// #### Usage
//
// ```
// _ : jcm800(t,m,l) : _
// ```
//
// Where:
//
// * `t`: treble control, between 0 and 1
// * `m`: middle control, between 0 and 1
// * `l`: bass control, between 0 and 1
//
// #### Test
// ```
// ts = library("tonestacks.lib");
// ba = library("basics.lib");
// ma = library("maths.lib");
// no = library("noises.lib");
// jcm800_test = no.noise : ts.jcm800(0.5, 0.5, 0.5);
// jcm800_slider_test = no.noise : ts.jcm800(hslider("jcm800:t", 0.5, 0, 1, 0.01), hslider("jcm800:m", 0.5, 0, 1, 0.01), hslider("jcm800:l", 0.5, 0, 1, 0.01));
// jcm800_modulated_test = no.noise : ts.jcm800(0.5, tri, 0.5) with { P = int(ma.SR/10); tri = 1 - abs(2*ba.period(P)/P - 1); };
// jcm800_jump_test = no.noise : ts.jcm800(0.5, 0.5, sq) with { P = int(ma.SR/10); sq = ba.period(2*P) < P; };
// ```
//
//----------------------------------------------------------
jcm800(T,M,L) = tonestack(t.C1,t.C2,t.C3,t.R1,t.R2,t.R3,t.R4,T,M,L) 
                    with {t = ts.jcm800;};
//---------------------------`jcm2000`--------------------------------
// Tone stack of the Marshall JCM-2000 Lead.
//
// #### Usage
//
// ```
// _ : jcm2000(t,m,l) : _
// ```
//
// Where:
//
// * `t`: treble control, between 0 and 1
