//---------------------------`ampeg`--------------------------------
// Tone stack of the Ampeg VL 501.
//
// #### Usage
//
// ```
// _ : ampeg(t,m,l) : _
// ```
//
// Where:
//
// * `t`: treble control, between 0 and 1
// * `m`: middle control, between 0 and 1
// * `l`: bass control, between 0 and 1
//----------------------------------------------------------
ampeg(T,M,L) = tonestack(t.C1,t.C2,t.C3,t.R1,t.R2,t.R3,t.R4,T,M,L) 
                    with {t = ts.ampeg;};
